# Configure privately in the existing Vercel project; never commit credentials.
# Keep false until sender/destination, storage, bot validation and real delivery are verified.
LAUNCH_FORM_ENABLED=false
RESEND_API_KEY=
# Existing verified sender can be reused; no visitor-supplied From address.
BETA_FROM_EMAIL=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=86chaos.com,www.86chaos.com
LAUNCH_ALLOWED_ORIGINS=https://86chaos.com,https://www.86chaos.com
# Dedicated marketing-only Upstash Free database; no paid plan or auto-upgrade.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LAUNCH_HASH_SECRET=
