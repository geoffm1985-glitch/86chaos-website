 .img-header{display:flex;align-items:center;justify-content:space-between;gap:9px;padding:8px 10px;background:linear-gradient(120deg,#042e66,#075394);border-bottom:2px solid #a4f42f;position:relative;z-index:80}
 .img-logo{width:min(66vw,255px);flex:0 1 auto;display:block}
 .img-menu{flex-shrink:0;position:relative}
 .img-menu>summary{list-style:none;padding:12px 10px;background:#074985;border:1px solid #a0ee2d;border-radius:8px;cursor:pointer;font-size:15px;font-weight:800;min-height:44px}
 .img-menu>summary::-webkit-details-marker{display:none}
 .img-menu nav{display:flex;flex-direction:column;position:absolute;right:0;top:calc(100% + 7px);width:min(270px,calc(100vw - 22px));background:#f7fbff;color:#063666;border:2px solid #9eee32;border-radius:11px;padding:6px;z-index:95;box-shadow:0 14px 26px #0024549c}
 .img-menu:not([open]) nav{display:none}
 .img-menu nav a{display:block;color:#063666;font-size:15px;font-weight:800;text-decoration:none;padding:12px;border-radius:6px}
 .img-menu nav a:hover{background:#e4f4de}
 .img-content{width:100%;background:linear-gradient(#033f83,#107dc8);overflow:hidden}
 .img-group{display:grid;gap:5px;padding:0 3px;margin:0;grid-template-columns:minmax(0,1fr);background:linear-gradient(130deg,#064987,#1179c5)}
 .img-grid-two{grid-template-columns:repeat(2,minmax(0,1fr))}
 .img-slice{position:relative;width:100%;min-width:0;overflow:hidden;display:block;isolation:isolate;line-height:0;background:#075ba8}
 .img-slice img{position:absolute;max-width:none!important;width:var(--picwidth)!important;height:var(--picheight)!important;left:var(--left);top:var(--top);display:block;object-fit:fill;pointer-events:none;user-select:none}
 .img-tap,.img-hotspot{position:absolute;display:block;inset:0;z-index:4;background:transparent;text-decoration:none;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
 .img-hotspot{inset:auto}
 .img-tap:focus-visible,.img-hotspot:focus-visible,.img-menu summary:focus-visible{outline:3px solid #a1f733;outline-offset:-3px}
 .img-grid-two>.img-slice:last-child:nth-child(odd){grid-column:1/-1;width:calc(50% - 2.5px);justify-self:center}
 .img-info{padding:42px 20px;min-height:400px;background:linear-gradient(135deg,#06305f,#097bc5)}
 .img-info h1{font-size:32px}.img-info p{font-size:17px;line-height:1.5}
 .img-info a{color:#adff3c;font-weight:800}
 .img-footer{padding:20px 12px 25px;display:flex;justify-content:center;gap:28px;background:#053a7e}
 .img-footer a{color:#b7ff4c;font-size:14px;font-weight:850;text-decoration:none}
}
