 </header>
 {groups.length? <main class="img-content">
  {groups.map((group,idx)=><section class:list={['img-group',group.cols===2?'img-grid-two':'img-grid-one']} id={page==='home'&&idx===1?'services':(page==='website'||page==='care')&&idx===4?'plans':undefined}>
   {group.pieces.map(piece=><div class="img-slice" style={styleFor(piece)}>
     <img src={artUrl} width={w} height={h} loading={idx<2?'eager':'lazy'} alt="" aria-hidden="true"/>
     {piece.to&&<a class="img-tap" href={href(piece.to)} aria-label={piece.to.startsWith('ask:')?'Request '+piece.to.slice(4):'View '+piece.to}></a>}
