   </div>)}
  </section>)}
 </main> : <main class="img-info"><h1>{page==='about'?'Chilton App Works':'Contact Chilton App Works'}</h1><p>Professional websites, custom applications, computer repair, website care and business email from Chilton, Wisconsin. Upfront pricing. No hidden fees.</p><a href="mailto:Geoffrey@86chaos.com">Email Geoffrey@86chaos.com</a></main>}
 <footer class="img-footer"><a href={base}>Home</a><a href={dest('website')}>Pricing</a><a href={dest('contact')}>Contact</a></footer>
</div>
<style>
.img-mobile{display:none}
@media(max-width:720px){
