 ['Bottom Get a Free Quote','ask:Website Design',269,1426,248,74],["Bottom Let's Talk",'contact',526,1426,249,74]
 ],
 apps:[
 ['Request a Custom Quote','ask:Custom Application Quote',33,270,269,68],
 ['Schedule a Consultation','ask:Custom Application Consultation',304,270,240,68],
 ['Restaurant Software','ask:Restaurant Software',20,405,315,137],
 ['Scheduling Systems','ask:Scheduling Systems',348,405,322,137],
 ['Inventory & Operations','ask:Inventory and Operations Apps',683,405,324,137],
