---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#073c7d"/>
<meta name="description" content={'Chilton App Works '+title+' interactive design preview. Affordable upfront prices, no hidden fees and local Wisconsin service.'}/>
<title>{title} | Chilton App Works</title>
<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:linear-gradient(130deg,#06376d,#086bc1);color:white;font-family:Arial,Helvetica,sans-serif}
a,button,summary{-webkit-tap-highlight-color:transparent;touch-action:manipulation}
a:focus-visible,summary:focus-visible,button:focus-visible{outline:3px solid #a6f52e;outline-offset:2px}
.site{width:min(1199px,100%);min-height:100vh;margin:auto;box-shadow:0 0 65px #001d4080}
.viewer{overflow-x:hidden;width:100%;background:#064b8f}
.poster{width:100%;position:relative;aspect-ratio:var(--w)/var(--h);isolation:isolate}
.poster-image{position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none;user-select:none}
.hit{display:block;position:absolute;z-index:5;background:transparent;border-radius:5px;text-decoration:none}
.hit:hover{background:#ffffff13}
.hit:focus-visible{outline:3px solid #a6f52e;background:#a6f52e35}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.actual-logo{position:absolute;z-index:7;display:block;background-color:#f7fbff;background-image:var(--logo);background-size:100% auto;background-position:center;background-repeat:no-repeat;border-radius:5px}
.services-menu{z-index:9;position:absolute}
.services-menu summary{display:block;width:100%;height:100%;list-style:none;cursor:pointer}
.services-menu summary::-webkit-details-marker{display:none}
.dropdown{display:none;position:absolute;z-index:60;top:90%;left:0;background:#fff;color:#062951;border:2px solid #9afa39;border-radius:9px;box-shadow:0 12px 30px #001b4d90;min-width:245px;padding:6px;flex-direction:column}
.dropdown a{display:block;color:#082d55;text-decoration:none;font-size:14px;line-height:1.3;white-space:nowrap;font-weight:800;padding:13px;border-radius:5px}
.dropdown a:hover{background:#e6f2ff}
.services-menu[open] .dropdown,.mobile-services[open] .dropdown{display:flex}
.zoom-row{display:none;justify-content:space-between;align-items:center;gap:14px;background:#043979;border-bottom:1px solid #80cbf880;padding:11px 14px;font-size:12px;line-height:1.35}
.zoom-row button{padding:10px 15px;border-radius:7px;background:#a3f42b;border:0;color:#082b51;font-weight:900;min-height:43px;white-space:nowrap}
.viewer.zoomed{overflow-x:auto;overscroll-behavior-x:contain}
.viewer.zoomed .poster{width:780px}
.note{background:#063b79;color:#e1f1ff;font-size:11px;line-height:1.65;padding:14px 19px}
.note a{color:#a8ff45;font-weight:800}
.mobilebar{display:none}
.info{background:linear-gradient(145deg,#063e8d,#1696db);padding:18px 5% 80px;min-height:65vh}
.info-head{display:flex;justify-content:space-between;align-items:center}
.info-logo{width:280px;height:85px;max-width:80%;background:white;background-image:var(--logo);background-position:center;background-size:100% auto;background-repeat:no-repeat;border-radius:8px;display:block}
.info-head nav{display:flex;gap:20px}
.info-head nav a{color:white;font-size:13px;font-weight:800;text-decoration:none}
.info-copy{max-width:790px;margin:70px auto 25px}
.info-copy h1{font-size:clamp(36px,6vw,68px);line-height:1.05;letter-spacing:-1px}
.info-copy h1 em{font-style:normal;color:#b5fb4b}
.info-copy p{font-size:17px;line-height:1.7}
.info-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;margin:27px 0}
.info-cards a{color:#073767;background:#fff;padding:20px;border-radius:10px;font-weight:800;text-decoration:none}
.info-cta{display:inline-block;padding:17px 22px;background:#a1f62b;border-radius:9px;font-weight:850;color:#063666;text-decoration:none;margin-top:15px}
@media(max-width:720px){
 .site{box-shadow:none;width:100%}
 .zoom-row{display:flex}
 .poster .desktop-nav-hit,.poster .services-menu{display:none}
 .actual-logo{display:none}
 .mobilebar{position:sticky;z-index:70;bottom:0;display:flex;align-items:center;justify-content:space-around;gap:5px;background:#053268f5;backdrop-filter:blur(9px);border-top:2px solid #a0f82c;padding:9px 6px calc(9px + env(safe-area-inset-bottom))}
 .mobilebar>a,.mobile-services summary{font-size:12px;font-weight:850;padding:10px 6px;white-space:nowrap;text-decoration:none;color:#fff}
 .mobilebar>a.contact-link{background:#a0f42c;color:#082f60;border-radius:8px;padding:11px 12px}
 .mobile-services{position:relative}
 .mobile-services summary{list-style:none;display:block;cursor:pointer}
 .mobile-services summary::-webkit-details-marker{display:none}
 .mobile-services .dropdown{top:auto;bottom:calc(100% + 15px);right:-80px;left:auto}
 .note{font-size:10px}
 .info-head nav{display:none}
 .info-cards{grid-template-columns:1fr}
}
@media(max-width:360px){.mobilebar>a,.mobile-services summary{font-size:11px;padding:9px 2px}}
</style>
</head>
<body style={'--logo:url('+ownerLogo+')'}>
<div class="site">
{visible?<>
 <div class="zoom-row"><span>Approved design · Fit to screen or zoom to read the details</span><button id="zoom" type="button" aria-pressed="false">Zoom In ⤢</button></div>
 <main class="viewer" id="viewer">
  <div class="poster" style={'--w:'+w+';--h:'+h}>
   <img class="poster-image" src={artUrl} alt={'Original approved blue, green and white Chilton App Works '+title+' mockup with mapped interactive buttons.'} width={w} height={h} loading="eager"/>
   <a class="actual-logo" href={base} aria-label="Original Chilton App Works logo, home" style={isHome?'left:1.2%;top:0%;width:26.8%;height:7.4%':'left:1.2%;top:0%;width:29%;height:5.1%'}></a>
   {overlay.map(([label,target,x,y,bw,bh])=><a class:list={['hit',{'desktop-nav-hit':(isHome?homeNav:pageNav).some(q=>q[0]===label&&q[2]===x)}]} aria-label={label} href={href(target)} style={'left:'+pct(x,w)+';top:'+pct(y,h)+';width:'+pct(bw,w)+';height:'+pct(bh,h)}><span class="sr">{label}</span></a>)}
   <details class="services-menu" style={'left:'+pct(servicesArea[0],w)+';top:'+pct(servicesArea[1],h)+';width:'+pct(servicesArea[2],w)+';height:'+pct(servicesArea[3],h)}>
     <summary aria-label="Open Services menu"></summary><div class="dropdown">{names.map(([label,key])=><a href={route(key)}>{label}</a>)}</div>
   </details>
   {isHome&&<span id="services" style="position:absolute;top:32%;left:0" aria-hidden="true"></span>}
   {(normalized==='website'||normalized==='care')&&<span id="plans" style="position:absolute;top:36%;left:0" aria-hidden="true"></span>}
  </div>
 </main>
 <div class="note">Interactive temporary Chilton App Works website on 86chaos.com. Starting prices and service availability are subject to approved scope. Free computer pickup and delivery applies within the agreed local service area; unsuccessful repairs are charged the agreed diagnostic fee only. Parts and provider costs are disclosed upfront. <a href={route('contact')}>Contact us</a>.</div>
 </>:<div class="info">
  <header class="info-head"><a class="info-logo" href={base} aria-label="Chilton App Works home"></a><nav><a href={base}>Home</a>{names.map(([label,key])=><a href={route(key)}>{label}</a>)}</nav></header>
  <main class="info-copy"><p style="font-size:12px;color:#b2fe37;font-weight:900;letter-spacing:2px">CHILTON APP WORKS LLC · WISCONSIN</p>
  <h1>{normalized==='about'?<>Local Roots.<br/><em>Practical Technology.</em></>:<>Let's Talk.<br/><em>Get a Quote.</em></>}</h1>
  <p>{normalized==='about'?'Chilton App Works LLC provides practical websites, custom applications, computer diagnostics and repairs, website care, and business email services for people and small businesses in Wisconsin. We believe in straightforward pricing, freedom of choice and no hidden fees.':'Tell us about your website, computer, software project or business email needs. We provide clear starting prices and discuss the expected cost before beginning any work.'}</p>
  <div class="info-cards">{names.map(([label,key])=><a href={normalized==='about'?route(key):mail(label+' inquiry')}>{label} ↗</a>)}</div>
  <a class="info-cta" href={mail('New service inquiry')}>Email Geoffrey@86chaos.com ↗</a>
  <p style="font-size:12px;margin-top:30px">Email links open your email application and do not automatically send or store data.</p>
  </main></div>}
<nav class="mobilebar" aria-label="Mobile navigation">
 <a href={base}>Home</a><details class="mobile-services"><summary>Services ▾</summary><div class="dropdown">{names.map(([label,key])=><a href={route(key)}>{label}</a>)}</div></details>
 <a href={route('website')}>Pricing</a><a href={route('about')}>About</a><a class="contact-link" href={route('contact')}>Contact</a>
</nav></div>
<script is:inline>
(function(){
 const button=document.getElementById('zoom'),viewer=document.getElementById('viewer');
 if(button&&viewer)button.addEventListener('click',()=>{
  const open=viewer.classList.toggle('zoomed');
  button.textContent=open?'Fit Screen ↙':'Zoom In ⤢';
  button.setAttribute('aria-pressed',String(open));viewer.scrollLeft=0;
 });
 document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',event=>{
  const node=document.getElementById(a.getAttribute('href').slice(1));
  if(node){event.preventDefault();node.scrollIntoView({behavior:'smooth'});}
 }));
})();
</script>
</body></html>