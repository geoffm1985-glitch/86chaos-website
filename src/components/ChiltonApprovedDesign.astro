const normalized=page==='website-design'||page==='pricing'?'website':page==='services'?'home':page==='work'?'apps':page;
const selected=art[normalized]||art.home;
const [artUrl,w,h]=selected;
const visible=!!art[normalized];
const isHome=normalized==='home';
const pct=(x:number,total:number)=>(100*x/total).toFixed(5)+'%';
const route=(name:string)=>name==='home'?base:base+'/'+(name==='website'?'website-design':name);
const mail=(title:string)=>'mailto:Geoffrey@86chaos.com?subject='+encodeURIComponent('Chilton App Works | '+title);
const href=(target:string)=>target.startsWith('ask:')?mail(target.slice(4)):target.startsWith('anchor:')?'#'+target.slice(7):route(target);
const title=normalized==='home'?'Chilton App Works':normalized==='website'?'Website Design':normalized==='apps'?'Custom Applications':normalized==='repair'?'Computer Repair & Tech Support':normalized==='care'?'Website Care':normalized==='email'?'Business Email':normalized==='about'?'About Chilton App Works':'Contact Chilton App Works';
type Box=[string,string,number,number,number,number];
const homeNav:Box[]=[
