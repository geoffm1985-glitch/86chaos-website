*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--white);font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}button{cursor:pointer}a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--coral);outline-offset:3px}::selection{background:var(--teal);color:#041016}.skip-link{position:absolute;top:-100px;left:14px;z-index:300;background:#fff;color:#000;padding:13px}.skip-link:focus{top:5px}.wrap,.section-wrap{max-width:var(--wrap);margin:0 auto;padding-left:27px;padding-right:27px}.section-wrap{padding-top:98px;padding-bottom:98px}section[id]{scroll-margin-top:100px}
.preview-strip{background:#0d161d;color:#97b6be;padding:9px max(27px,calc((100vw - var(--wrap))/2 + 27px));font-size:9px;font-weight:900;letter-spacing:1.1px;display:flex;align-items:center;gap:10px}.pulse-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--teal);box-shadow:0 0 12px var(--teal)}.preview-end{margin-left:auto;color:#7197a0}.preview-strip a{color:var(--coral);white-space:nowrap}.site-header{position:sticky;top:0;background:#060f14e8;backdrop-filter:blur(20px);border-bottom:1px solid #1a444c;z-index:100}.header-inner{max-width:var(--wrap);padding:16px 27px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:20px}.brand{display:flex;align-items:center;gap:11px;flex-shrink:0}.brand img{width:50px;height:56px;object-fit:contain;filter:drop-shadow(0 0 8px #3cf4e331)}.brand>span{display:flex;flex-direction:column;font-family:'Space Grotesk';line-height:.96}.brand strong{font-size:25px;letter-spacing:-.9px;font-weight:700}.brand small{font-size:19px;color:var(--teal);letter-spacing:-.8px;font-weight:600}.desktop-nav{display:flex;align-items:center;gap:30px}.desktop-nav a{font-weight:750;font-size:12px;color:#e2eced;white-space:nowrap}.desktop-nav a:hover{color:var(--teal)}.top-cta{padding:13px 17px;border:1px solid #ffbea9;border-radius:8px;box-shadow:0 0 18px #ff74594d, inset 0 0 16px #ff836e18;background:linear-gradient(110deg,#ff9077,#f16e66);color:#09202c;font-weight:900;font-size:12px;white-space:nowrap}.top-cta span{margin-left:18px}.mobile-nav{display:none}
