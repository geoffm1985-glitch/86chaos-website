---
const mark='/assets/chilton-symbol-neon.svg';
const offers=[
  {name:'One-Page Starter',price:'$149',subtitle:'Everything you need to get noticed.',features:['One professionally designed, mobile-friendly page','Tested template customized with your brand','Your supplied text, logo and photos','Contact links and basic search setup','One round of revisions'],key:'One-Page Starter website ($149)',featured:true},
  {name:'Small Business',price:'$349',subtitle:'A little more room to tell your story.',features:['Up to three responsive pages','Brand colors and business-focused layout','Services, about and contact information','Basic local-search setup','One round of revisions'],key:'Small Business website ($349)'},
  {name:'Business Plus',price:'$599',subtitle:'More pages. More possibilities.',features:['Up to five responsive pages','More tailored visual design','Gallery or service showcase','Clear mobile calls to action','Two rounds of revisions'],key:'Business Plus website ($599)'}
];
const care=[
 {title:'Basic Hosting',price:'$19',description:'Managed hosting for eligible static sites, SSL and routine monitoring. Content changes quoted separately.'},
 {title:'Managed Care',price:'$39',description:'Hosting benefits, monitoring and up to 15 minutes of minor content edits per month.'},
 {title:'Premium Care',price:'$69',description:'Hosting benefits, monitoring and up to 30 minutes of minor edits per month.'}
];
const faqs=[
 ['What does the $149 website include?','A single mobile-friendly page using a tested professional template, with your provided copy, photos and logo, contact links, basic search setup and one revision round. Domain, hosting, paid email and extra features are separate.'],
 ['Do I need a monthly plan?','No. Maintenance and managed hosting are optional. You can choose another hosting provider. We explain any handoff requirements and third-party costs in your proposal.'],
 ['Do I own the website and domain?','Your domain belongs to your business, and you own the final completed website deliverables defined in your project agreement. No artificial provider lock-in.'],
 ['Can you set up business email?','Yes. Setup for the first mailbox starts at $49 one-time. Domain charges and the email provider’s paid mailbox license are separate, ordinarily paid directly to the provider.'],
 ['What about more pages or custom software?','Additional website pages start at $99 each. Complex forms, copywriting, online payments, booking, databases, integrations and custom applications are individually scoped and quoted.'],
 ['How do website care plans work?','Optional care is month-to-month with 30 days notice to cancel. Website care includes defined monitoring and up to 15 or 30 minutes of minor edits for selected plans. Unused edit minutes do not roll over.']
];
const mail=(topic:string)=>'mailto:Geoffrey@86chaos.com?subject='+encodeURIComponent('Chilton App Works | '+topic);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="theme-color" content="#050c11"/>
  <meta name="robots" content="noindex,nofollow"/>
  <meta name="description" content="Explore the neon Chilton App Works website concept. Affordable professional websites starting at $149, custom applications, optional care and business email. No hidden fees."/>
  <title>Chilton App Works | Neon Studio Concept · Websites from $149</title>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<div class="preview-strip"><span class="pulse-dot"></span><span>CHILTON APP WORKS / NEON STUDIO PREVIEW</span><span class="preview-end">TEMPORARY DESIGN CONCEPT · HOSTED ON 86CHAOS.COM</span><a href="/chilton-app-works-preview">Original preview ↗</a></div>
<header class="site-header">
 <div class="header-inner">
   <a class="brand" href="#top" aria-label="Chilton App Works home"><img src={mark} width="53" height="59" alt="Chilton App Works geometric symbol in teal and coral"/><span><strong>Chilton</strong><small>App Works</small></span></a>
   <nav class="desktop-nav" aria-label="Main navigation"><a href="#services">Services</a><a href="#pricing">Pricing</a><a href="#why">Why it matters</a><a href="#about">Our approach</a><a href="#contact">Contact</a></nav>
   <a class="top-cta" href="#contact">Let's Talk <span>↗</span></a>
   <details class="mobile-nav"><summary aria-label="Open navigation">Menu <span>☰</span></summary><nav aria-label="Mobile navigation"><a href="#services">Services</a><a href="#pricing">Pricing</a><a href="#why">Why it matters</a><a href="#about">Our approach</a><a href="#contact">Contact</a></nav></details>
 </div>
</header>
<main id="main">
 <section class="hero" id="top">
   <div class="hero-container">
     <div class="hero-copy">
        <div class="hero-eyebrow"><span class="short-bar"></span> INDEPENDENT DIGITAL STUDIO · CHILTON, WI</div>
        <h1>Build a Better<br/><span class="teal-text">Digital First</span><br/><span class="coral-text">Impression.</span></h1>
        <p>Custom apps and websites for small businesses that want to look professional, work smarter, and grow online.</p>
        <div class="main-offer"><i></i><strong>Websites from <span>$149</span></strong></div>
        <div class="hero-actions"><a class="btn btn-coral" href="#contact">Start Your Project <span>↗</span></a><a class="btn btn-outline" href="#services">See Our Services</a></div>
        <p class="hero-fine">One-page starter website from $149 one-time. Domain, hosting, email subscriptions and add-ons priced separately.</p>
     </div>
     <div class="hero-visual" role="img" aria-label="Stylized laptop illustration showing an example business website, surrounded by neon teal and coral geometric light panels">
       <div class="neon-sweep sweep-a"></div><div class="neon-sweep sweep-b"></div><div class="neon-sweep sweep-c"></div>
       <div class="hero-star glow-one"></div><div class="hero-star glow-two"></div>
       <div class="laptop">
        <div class="laptop-frame">
          <div class="screen-top"><span class="screen-oval"></span><span>HOME</span><span>SERVICES</span><span>CONTACT</span></div>
          <div class="screen-landscape"><span class="screen-kicker">YOUR BUSINESS, BEAUTIFULLY ONLINE</span><strong>Your Business<br/>Online.</strong><span class="screen-cta">EXPLORE ↗</span><div class="mountain mountain-back"></div><div class="mountain mountain-front"></div></div>
          <div class="screen-tiles"><span>◈</span><span>▧</span><span>☰</span></div>
        </div>
        <div class="laptop-base"><div class="laptop-trackpad"></div></div>
       </div>
       <div class="hero-art-label">YOUR BRAND / YOUR POSSIBILITIES ↗</div>
     </div>
   </div>
 </section>
 <section class="service-strip" id="services" aria-labelledby="services-heading">
   <div class="wrap">
     <div class="mini-heading"><span>WHAT WE CAN DO</span><h2 id="services-heading">More than a website.</h2></div>
     <div class="service-grid">
       <a href="#pricing" class="service-card"><span class="service-icon teal-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg></span><span><strong>Professional<br/>Websites</strong><small>Modern, mobile-friendly sites built for the real world.</small></span><b>↗</b></a>
       <a href="#custom-apps" class="service-card"><span class="service-icon coral-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5-6 7 6 7m8-14 6 7-6 7m-4-19-3 24"/></svg></span><span><strong>Custom<br/>Apps</strong><small>Purpose-built tools for how your business operates.</small></span><b>↗</b></a>
       <a href="#care" class="service-card"><span class="service-icon teal-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 10 6-10 6L2 8l10-6Zm-10 11 10 6 10-6M2 18l10 6 10-6" transform="translate(0 -1) scale(1 .92)"/></svg></span><span><strong>Website<br/>Care</strong><small>Optional hosting, monitoring and site upkeep.</small></span><b>↗</b></a>
       <a href="#email" class="service-card"><span class="service-icon coral-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 8 10-8"/></svg></span><span><strong>Business<br/>Email</strong><small>Professional email addresses for your brand.</small></span><b>↗</b></a>
     </div>
   </div>
 </section>
 <section class="pricing-section section-wrap" id="pricing">
   <div class="section-header"><div><span class="section-kicker">PRICING & PACKAGES <i></i></span><h2>Simple, Transparent<br/><span>Pricing.</span></h2></div><p>Professional websites, ongoing care and custom business tools at prices that make sense.</p></div>
   <div class="pricing-grid">
      {offers.map((plan,i)=><article class:list={['pricing-card',{'special':i===0}]}>
         {i===0&&<div class="popular-label">BEST PLACE TO START</div>}
         <span class="card-tag">{plan.name}</span>
         <div class="price">{plan.price}<small>one-time build</small></div>
         <p>{plan.subtitle}</p>
         <ul>{plan.features.map(f=><li><span aria-hidden="true">✓</span>{f}</li>)}</ul>
         <a href="#contact" data-service={plan.key} class="price-action">Ask About This Package <span>↗</span></a>
      </article>)}
      <div class="extras-stack">
        <article class="extra-card"><span class="extra-icon">⊞</span><div><strong>Additional Pages</strong><p>More space as your business grows.</p></div><span class="extra-amount"><small>from</small><b>$99</b></span></article>
        <a href="#care" class="extra-card"><span class="extra-icon">⚙</span><div><strong>Website Care</strong><p>Optional hosting, monitoring and edits.</p></div><span class="extra-amount"><b class="long">$19 / $39 / $69</b><small>per month</small></span></a>
        <a href="#email" class="extra-card"><span class="extra-icon">✉</span><div><strong>Business Email Setup</strong><p>Mailbox setup for your own domain.</p></div><span class="extra-amount"><small>from</small><b>$49</b></span></a>
        <div class="extras-fine"><span>✳</span> No hidden charges. Your domain, hosting, paid email licenses, and third-party services are priced separately and approved in advance.</div>
      </div>
   </div>
   <p class="pricing-footnote">* Packages are starting prices for defined scopes. Customers supply copy, photos and logos for standard packages. Complex features, e-commerce, bookings, integrations, extra revisions, or additional content are separately quoted. Domain ownership and agreed final deliverables remain yours.</p>
 </section>
 <section class="apps-section" id="custom-apps">
   <div class="wrap apps-inner">
     <div class="apps-copy"><span class="section-kicker">CUSTOM SOFTWARE, CUSTOM FIT</span><h2>Built for<br/><span>your workflow.</span></h2><p>Not everything fits into an off-the-shelf app. From employee tools and scheduling to inventory dashboards and client portals, we build software around the work you actually do.</p><a class="btn btn-teal" href="#contact" data-service="Custom application development">Discuss a Custom App <span>↗</span></a><p class="apps-fine">Custom applications are quoted individually, including security, testing, integrations, hosting, and ongoing support.</p></div>
     <div class="app-ui" aria-label="Illustrative custom application dashboard, not real client data"><div class="app-panel-top"><b><span>✳</span> MY BUSINESS</b><span>◉ ACTIVE</span></div><div class="app-panel-body"><small>GOOD MORNING</small><h3>Everything in one place.</h3><div class="app-metrics"><div><span>OPERATIONS</span><strong>On track</strong><small>✓ All systems ready</small></div><div><span>TEAM UPDATES</span><strong>Organized</strong><small>✓ Today at a glance</small></div></div><div class="app-chart"><strong>Activity overview</strong><div class="chart-bars"><i/><i/><i/><i/><i/><i/><i/></div></div></div><p>ILLUSTRATION · NO LIVE CUSTOMER DATA</p></div>
   </div>
 </section>
 <section class="why-section section-wrap" id="why">
   <div class="section-header"><div><span class="section-kicker">WHY YOUR WEBSITE MATTERS <i></i></span><h2>A better first impression<br/><span>has real value.</span></h2></div><p>People use online search to decide which local businesses to call, visit and trust. A professional website gives them a clear place to start.</p></div>
   <div class="stats">
     <article><strong>84%</strong><p>of surveyed U.S. consumers searched for a local business online during the previous three months.</p><a href="https://www.brightlocal.com/research/consumer-search-behavior-channels/" target="_blank" rel="noopener noreferrer">BRIGHTLOCAL 2026 ↗</a></article>
     <article><strong>73%</strong><p>of surveyed recent local searchers started their latest business search on a mobile device.</p><a href="https://www.brightlocal.com/research/consumer-search-behavior-channels/" target="_blank" rel="noopener noreferrer">BRIGHTLOCAL 2026 ↗</a></article>
     <article><strong>20%</strong><p>ranked a professional-looking website among their top three reasons to contact or visit a business.</p><a href="https://www.brightlocal.com/research/consumer-search-behavior-decisions/" target="_blank" rel="noopener noreferrer">BRIGHTLOCAL 2026 ↗</a></article>
   </div>
   <p class="stats-caveat">Consumer survey statistics, not promises of increased revenue. BrightLocal's 2026 decision research includes a sample of 1,227 recent U.S. local-business searchers.</p>
 </section>
 <section class="care-email-section section-wrap" id="care">
   <div class="section-header"><div><span class="section-kicker">OPTIONAL ONGOING SUPPORT <i></i></span><h2>Launch it. Love it.<br/><span>Keep it running.</span></h2></div><p>Maintenance is always your choice. Keep control of your hosting or let us handle routine upkeep through a clear, month-to-month plan.</p></div>
   <div class="care-grid">{care.map(c=><article><div class="care-top"><strong>{c.title}</strong><span>{c.price}<small>/mo</small></span></div><p>{c.description}</p></article>)}</div>
   <p class="care-fine">Optional month-to-month care with 30 days notice to cancel. Plans assume eligible static sites with reasonable usage. Domain renewals, paid integrations, mailbox licenses, unusual provider charges and larger changes are disclosed and quoted separately. Unused edit minutes do not roll over.</p>
   <div class="email-row" id="email"><span class="email-glyph">✉</span><div><span>PROFESSIONAL INBOX</span><h3>Business email, without the mystery.</h3><p>First mailbox setup starts at <b>$49 one-time</b>. Domain registration and ongoing mailbox subscriptions from your chosen provider cost extra, usually paid directly to them.</p></div><a href="#contact" data-service="Business email setup" class="email-action">Ask About Email <span>↗</span></a></div>
 </section>
 <section class="approach-section" id="about"><div class="wrap approach-grid"><div><span class="section-kicker">SMALL BUSINESS. BIG IDEAS.</span><h2>Built on clarity.<br/><span>Not fine print.</span></h2><p>We believe professional digital work should be approachable. You'll know what's included, what costs extra, and what you own before we build anything.</p></div><div class="approach-points"><div><span>✳</span><strong>A project scope you can understand</strong></div><div><span>✳</span><strong>No surprise third-party charges</strong></div><div><span>✳</span><strong>No forced maintenance agreements</strong></div><div><span>✳</span><strong>Your brand and domain stay yours</strong></div></div></div></section>
 <section class="faq-section section-wrap"><div class="section-header"><div><span class="section-kicker">COMMON QUESTIONS <i></i></span><h2>Let's clear<br/><span>things up.</span></h2></div><p>Affordable doesn't have to mean confusing. Here are the things most businesses ask before starting.</p></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></section>
 <section class="contact-section" id="contact">
  <div class="contact-glow left-glow"></div><div class="contact-glow right-glow"></div>
  <div class="wrap contact-grid">
    <div><span class="section-kicker">LET'S BUILD SOMETHING USEFUL</span><h2>Ready to Grow<br/>Your Business <span>Online?</span></h2><p>Tell us about your project. We'll help find an approach that makes sense for your budget and your goals.</p><div class="contact-badge">✳ &nbsp; CHILTON, WISCONSIN</div></div>
    <form class="contact-form" id="inquiry-form">
       <h3>Start Your Project <span>↗</span></h3>
       <label>Your name <span>*</span><input required name="name" autocomplete="name" placeholder="Your name"/></label>
       <label>Your email <span>*</span><input required type="email" name="email" autocomplete="email" placeholder="you@business.com"/></label>
       <label>Your business<input name="business" placeholder="Business name (optional)"/></label>
       <label>What can we help with?<select name="interest" id="interest"><option>One-Page Starter website ($149)</option><option>Small Business website ($349)</option><option>Business Plus website ($599)</option><option>Custom application development</option><option>Business email setup</option><option>Website care and hosting</option><option>Other digital project</option></select></label>
       <label>Tell us about your idea<textarea name="details" placeholder="What would you like to build?" rows="3"></textarea></label>
       <button type="submit" class="btn btn-coral contact-submit">Prepare Email Inquiry <span>↗</span></button>
       <p class="form-disclosure">This preview opens your email app with a prepared message. Nothing is sent or stored on the website.</p>
    </form>
  </div>
 </section>
</main>
<footer><div class="wrap footer-content"><a href="#top" class="brand footer-brand"><img src={mark} width="44" height="49" alt="Chilton App Works logo symbol"/><span><strong>Chilton</strong><small>App Works</small></span></a><div class="footer-nav"><a href="#pricing">Pricing</a><a href="#services">Services</a><a href="#care">Care</a><a href="#contact">Contact</a></div><span class="footer-legal">© 2026 Chilton App Works LLC · Concept preview hosted on 86chaos.com</span></div></footer>
<script>
  const interest=document.querySelector('#interest');
  document.querySelectorAll('[data-service]').forEach(link=>{
    link.addEventListener('click',()=>{
      const service=link.getAttribute('data-service');
      if(interest && service && Array.from(interest.options).some(o=>o.value===service)){
        interest.value=service;
      }
    });
  });
  document.querySelectorAll('.mobile-nav nav a').forEach(link=>{
    link.addEventListener('click',()=>{
      const menu=document.querySelector('.mobile-nav');
      if(menu) menu.removeAttribute('open');
    });
  });
  const form=document.querySelector('#inquiry-form');
  if(form){
    form.addEventListener('submit',(event)=>{
      event.preventDefault();
      const data=new FormData(form);
      const get=(key)=>String(data.get(key)||'').trim();
      const subject='Chilton App Works | Project inquiry: '+get('interest');
      const body='Name: '+get('name')+'\nBusiness: '+(get('business')||'Not specified')+'\nReply email: '+get('email')+'\nInterested in: '+get('interest')+'\n\nProject details:\n'+(get('details')||'Not provided')+'\n\nPrepared from the Chilton App Works neon preview.';
      window.location.href='mailto:Geoffrey@86chaos.com?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);
    });
  }
</script>
</body>
</html>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap');
