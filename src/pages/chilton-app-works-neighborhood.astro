const logo='https://chilton-app-works-business-website-y0yj33.v2.appdeploy.ai/resources/chilton-app-works-logo.jpg';
const prices=[
 {title:'The Essential',amount:'$149',meta:'ONE-PAGE STARTER',desc:'One beautifully straightforward page to help people find, understand and contact your business.',features:['One mobile-friendly page','Your business details, photos and logo','Contact links and search basics','A tested layout and one revision round'],inquiry:'$149 one-page website'},
 {title:'Room to Grow',amount:'$349',meta:'UP TO THREE PAGES',desc:'Space for your services, your story and the practical details customers need.',features:['Up to three responsive pages','A coordinated look and feel','Business services and contact pages','Basic local-search setup and one revision round'],inquiry:'$349 three-page website'},
 {title:'The Full Story',amount:'$599',meta:'UP TO FIVE PAGES',desc:'A more tailored home for everything that makes your business different.',features:['Up to five responsive pages','More customized presentation','Gallery or service showcase','Two revision rounds'],inquiry:'$599 five-page website'}
];
const maintenance=[
 {name:'Basic Hosting',price:'$19',description:'Eligible static-site hosting, SSL and monitoring. Edits quoted separately.'},
 {name:'Managed Care',price:'$39',description:'Hosting benefits and up to 15 minutes of minor edits monthly.'},
 {name:'Premium Care',price:'$69',description:'Hosting benefits and up to 30 minutes of minor edits monthly.'}
];
const mail=(x:string)=>'mailto:Geoffrey@86chaos.com?subject='+encodeURIComponent('Chilton App Works - '+x);
