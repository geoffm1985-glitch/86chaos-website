---
const title='Yardmaster | Local-first workflow control';
const description='Yardmaster is a local-first Windows operator with a secure mobile PWA remote for tests, Git, ChatGPT, and deployments.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#071525" />
<link rel="manifest" href="/yardmaster/manifest.webmanifest" />
<link rel="icon" href="/yardmaster/yardmaster-icon.svg" />
<link rel="apple-touch-icon" href="/yardmaster/yardmaster-icon.svg" />
<style is:inline>
:root{--bg:#061321;--panel:#0b1c2d;--panel2:#102438;--line:#1d354a;--text:#f6f4ef;--muted:#8fa0ae;--copper:#c97f46;--copper2:#e5a16d;--green:#34c878;--red:#d95b5b;--steel:#b9c2c9}*{box-sizing:border-box}html,body{margin:0;min-height:100%;max-width:100%;overflow-x:hidden;background:radial-gradient(circle at 68% -10%,#173249 0,#081a29 36%,#05111c 72%);color:var(--text);font-family:Inter,Segoe UI,Arial,sans-serif}body:before{content:"";position:fixed;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 0 75%,#c97f4608 75% 76%,transparent 76%)}a{color:inherit}.desktop{min-height:100vh;padding:28px 24px 42px;display:grid;place-items:center}.desktop-inner{width:min(1180px,100%)}.brand{width:min(560px,72vw);display:block;margin-bottom:16px}.topnote{color:#a4b2bd;letter-spacing:.12em;text-transform:uppercase;font-size:12px}.hero{display:grid;grid-template-columns:1fr 460px;gap:34px;align-items:center}.copy h1{font-size:clamp(42px,6vw,80px);line-height:.96;margin:12px 0 18px;max-width:760px}.copy h1 span{color:#e59e69}.copy p{font-size:18px;color:#a7b6c1;line-height:1.6;max-width:650px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0}.button{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border-radius:12px;padding:14px 20px;font-weight:800;border:1px solid #2f4b60;background:#14293a;color:white;cursor:pointer}.button.primary{background:linear-gradient(135deg,#a55e39,#d98a54);border-color:#e19a68}.button.green{background:linear-gradient(135deg,#177d4e,#2cca79);border-color:#4ce29a}.button.ghost{background:#0a1927}.note{font-size:12px;color:#8494a0}.preview{border:1px solid #264158;border-radius:22px;background:linear-gradient(180deg,#0d2133,#081724);box-shadow:0 28px 100px #0009;padding:18px;position:relative;overflow:hidden}.preview:after{content:"";position:absolute;right:-60px;bottom:-60px;width:220px;height:220px;border:1px solid #c97f4633;border-radius:50%}.preview-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.status{font-size:12px;color:#73e9a6}.panel{background:#091a29;border:1px solid #1d3850;border-radius:15px;padding:15px;margin-top:10px}.eyebrow{font-size:11px;color:#8fa1ae;letter-spacing:.12em;text-transform:uppercase}.panel h3{margin:6px 0 12px}.rail{height:76px}.rail svg{width:100%;height:100%}.progress{height:10px;background:#1a3143;border-radius:999px;overflow:hidden}.progress div{width:66%;height:100%;background:linear-gradient(90deg,#c97f46,#e9ad7b,#51dc8d)}.mini-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px}.mini{background:#071522;border:1px solid #173247;border-radius:10px;padding:9px;font-size:11px}.mini b{display:block;font-size:18px}.pass b{color:#59e299}.fail b{color:#ff7b7b}.download-card{margin-top:22px;padding:18px;border:1px solid #24435a;background:#091a29;border-radius:16px;display:flex;justify-content:space-between;gap:16px;align-items:center}.download-card small{color:#91a1ad}.mobile{display:none;min-height:100dvh}.m-head{display:flex;align-items:center;justify-content:space-between;padding:calc(12px + env(safe-area-inset-top)) 12px 12px;border-bottom:1px solid #183247}.m-head img{width:min(190px,48vw)}.m-content{padding:12px 12px calc(76px + env(safe-area-inset-bottom));display:grid;gap:12px}.m-card{background:#0b1d2d;border:1px solid #1d3850;border-radius:15px;padding:14px;min-width:0}.m-card h3{margin:0 0 8px}.m-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:13px}.m-btn{min-height:44px;padding:11px 7px;border-radius:10px;border:1px solid #2c465d;background:#13273a;color:white;font-weight:800;touch-action:manipulation}.m-btn.start{background:linear-gradient(135deg,#168b56,#2ac978);border-color:#43e99d}.m-btn.stop{background:#3a151c;border-color:#8a353e;color:#ffaaa9}.m-btn.new{width:100%;margin-top:12px;background:linear-gradient(135deg,#a55f31,#d68b52);border-color:#efb17f}.field{display:grid;gap:7px;margin-top:10px}.field label{font-size:11px;color:#8da0ad}.field input,.field select,.field textarea{min-width:0;width:100%;background:#071522;border:1px solid #28465d;color:#fff;border-radius:10px;padding:11px;font:inherit}.field textarea{min-height:130px;resize:vertical}.activity{display:grid;gap:8px;font-size:12px;color:#a7b3bd}.activity-row{display:grid;grid-template-columns:54px 8px minmax(0,1fr);gap:8px}.dot{width:7px;height:7px;border-radius:50%;background:#38d77f;margin-top:4px}.overlay{position:fixed;inset:0;background:#061321ee;z-index:50;padding:calc(16px + env(safe-area-inset-top)) 16px calc(16px + env(safe-area-inset-bottom));display:none;align-items:center;justify-content:center;overflow:auto}.overlay.show{display:flex}.connect{width:min(430px,100%);max-height:100%;overflow:auto;background:#0b1c2d;border:1px solid #28425a;border-radius:20px;padding:20px}.connect img{width:min(220px,70%);display:block;margin:0 auto 10px}.connect h2{text-align:center}.connect p{color:#9aacb9}.tiny{font-size:11px;color:#8495a1}.install-banner{background:#102824;border:1px solid #2a5a49;color:#d5f2e1;border-radius:12px;padding:12px;margin-top:12px}.mobile-nav{position:fixed;left:0;right:0;bottom:0;z-index:40;display:grid;grid-template-columns:repeat(5,1fr);padding-bottom:env(safe-area-inset-bottom);background:#071523f2;border-top:1px solid #1e374b;backdrop-filter:blur(12px)}.m-console-head{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.m-console-meta{font-size:11px;color:#8fa1ae;overflow-wrap:anywhere}.m-console-actions{display:flex;gap:6px;margin:9px 0}.m-console-actions button{min-height:34px;padding:7px 9px;font-size:11px}.m-console{margin:0;max-height:42dvh;min-height:180px;overflow:auto;white-space:pre-wrap;word-break:break-word;background:#06111c;border:1px solid #17364c;border-radius:10px;padding:11px;font:11px/1.45 Consolas,"SFMono-Regular",monospace;color:#d7e1e8}.mobile-nav button{min-height:48px;background:none;border:0;color:#93a2ae;padding:10px 4px;font-size:11px}.mobile-nav button.active{color:#f0a56c}.remote-error{color:#ffaaa9}.work-check{display:flex;gap:8px;align-items:flex-start;margin-top:12px;font-size:12px;color:#c6d1d8}@media(max-width:760px){.desktop{display:none}.mobile{display:block}body.ym-auth-pending #overlay{display:flex}body.ym-auth-pending .m-content,body.ym-auth-pending .mobile-nav{visibility:hidden;pointer-events:none;user-select:none}body.ym-authenticated #overlay{display:none}}@media(max-width:380px){.m-head{align-items:flex-start}.m-head>div{flex-direction:column}.m-btn{font-size:12px}}@media(min-width:761px){.overlay{display:none!important}} 
</style>
</head>
<body class="ym-auth-pending">
<section class="desktop">
  <div class="desktop-inner">
    <img class="brand" src="/yardmaster/yardmaster-logo.svg" alt="Yardmaster" />
    <div class="hero">
      <div class="copy">
        <div class="topnote">Local-first desktop operator + secure PWA remote</div>
        <h1>Keep the work <span>moving.</span></h1>
        <p>Yardmaster runs your approved local test commands, watches progress, controls Git and deployment handoffs, and gives you a secure remote control from your phone. Operational history stays on your Windows PC.</p>
        <div class="actions">
          <a class="button primary" href="/yardmaster/download">DOWNLOAD YARDMASTER FOR WINDOWS</a>
          <button class="button green" id="desktopInstallPwa">Install Mobile PWA</button>
        </div>
        <div class="note">Verified Yardmaster 0.1.37 • Released September 28, 2026 • Windows requires Node.js 22+ • Remote access uses an optional Cloudflare Quick Tunnel.</div>
        <div class="download-card"><div><b>Mobile PWA</b><br><small>Open this page on your phone and choose Add to Home Screen. Pair it from the Windows dashboard.</small></div><span>📱</span></div>
      </div>
      <div class="preview">
        <div class="preview-top"><img src="/yardmaster/yardmaster-icon.svg" width="54" height="54"><span class="status">● PC Online</span></div>
        <div class="panel"><div class="eyebrow">Current Run • Running</div><h3>Full Release Gate</h3><div class="rail"><svg viewBox="0 0 500 80" preserveAspectRatio="none"><path d="M0 12 H175 C225 12 235 40 270 40 H500" stroke="#c97f46" stroke-width="7" fill="none"/><path d="M0 30 H185 C225 30 235 40 270 40 H500" stroke="#bdc7ce" stroke-width="7" fill="none"/><path d="M0 48 H188 C225 48 235 40 270 40 H500" stroke="#36c777" stroke-width="7" fill="none"/><path d="M0 66 H175 C225 66 235 40 270 40 H500" stroke="#818d97" stroke-width="7" fill="none"/><circle cx="283" cy="40" r="12" fill="#071525" stroke="#d08a56" stroke-width="6"/></svg></div><div class="progress"><div></div></div><div class="mini-grid"><div class="mini pass">Passed<b>248</b></div><div class="mini fail">Failed<b>0</b></div><div class="mini">Skipped<b>7</b></div></div></div>
        <div class="panel"><div class="eyebrow">Current stage</div><h3>Waiting for exact Vercel deployment</h3><div class="tiny">Branch: testing • Repo update: Ask Me • ChatGPT mode: Work</div></div>
      </div>
    </div>
  </div>
</section>

<section class="mobile">
  <header class="m-head"><img src="/yardmaster/yardmaster-logo.svg" alt="Yardmaster"><div style="display:flex;gap:6px"><button class="m-btn" id="alertsBtn">🔔 Alerts</button><button class="m-btn" id="installPwa">＋ Install</button></div></header>
  <div class="m-content">
    <div class="m-card"><span style="color:#58e79b">●</span> <b id="mPc">Not connected</b><div class="tiny" id="mConn">Pair with your Windows Yardmaster operator.</div></div>
    <div class="m-card" id="mControlCard"><div class="eyebrow">Current Run</div><h3 id="mTitle">Ready for work</h3><div><span id="mTest">Idle</span><b style="float:right" id="mPct">0%</b></div><div class="progress" style="margin-top:9px"><div id="mBar" style="width:0%"></div></div><div class="mini-grid"><div class="mini pass">Pass<b id="mPass">0</b></div><div class="mini fail">Fail<b id="mFail">0</b></div><div class="mini">Skip<b id="mSkip">0</b></div></div><button class="m-btn new" id="mobileNewWorkControl">＋ New 86 Chaos Work</button><div class="tiny" style="margin-top:6px">Start a new feature or update from your phone. The work runs on your paired Windows Yardmaster PC.</div><div class="m-controls"><button class="m-btn start" data-act="start">▶ Start</button><button class="m-btn" data-act="pause">Ⅱ Pause</button><button class="m-btn" data-act="resume">▶ Resume</button><button class="m-btn stop" data-act="stop">■ Stop</button></div></div>
    <div class="m-card" id="mConsoleCard"><div class="m-console-head"><div><div class="eyebrow">Live Command Output</div><h3 style="margin:3px 0 2px">PC Console</h3></div><span class="tiny" id="mConsoleState">Idle</span></div><div class="m-console-meta" id="mConsoleCommand">No command running.</div><div class="m-console-actions"><button class="m-btn" id="consoleAutoScroll">Auto-scroll: On</button><button class="m-btn" id="copyConsole">Copy</button></div><pre class="m-console" id="mConsole">Yardmaster ready.</pre></div>
    <div class="m-card" id="mSettingsCard"><button class="m-btn new" id="mobileNewWork">＋ New 86 Chaos Work</button><div class="field"><label>Branch</label><select id="branch"><option>testing</option></select></div><div class="field"><label>Deployment URL</label><input id="testingUrl" value="https://testing.86chaos.com"></div><div class="field"><label>Test Type</label><select id="testType"><option value="delta">Delta / Targeted</option><option value="full">Full Release Gate</option><option value="targeted">Current Release Targeted</option></select></div><div class="field"><label>ChatGPT Mode</label><select id="chatMode"><option>Work</option><option>Chat</option></select></div><div class="field"><label>Model</label><input id="model" list="yardmasterModels" value="GPT-5.6 Sol"><datalist id="yardmasterModels"><option value="GPT-5.6 Sol"><option value="GPT-5.6 Terra"><option value="GPT-5.6 Luna"><option value="GPT-6 Astra"></datalist></div><div class="field"><label>Thinking Effort</label><select id="thinkingEffort"><option value="Instant">Instant / Auto</option><option value="Medium">Medium</option><option value="High">High</option></select></div><div class="field"><label>Local Repo Update</label><select id="repoMode"><option value="automatic" selected>Automatic</option><option value="ask">Ask Me</option><option value="never">Never</option></select></div><div class="field"><label>Automatic Repair Attempts</label><select id="maxRepairs"><option value="25" selected>25</option><option value="50">50</option><option value="100">100</option><option value="0">Unlimited</option></select></div><div class="field"><label>Send Failures to ChatGPT</label><select id="autoHandoff"><option value="true">Yes</option><option value="false">No</option></select></div><div class="field"><label>Push After Pass</label><select id="autoPush"><option value="false">No</option><option value="true">Yes</option></select></div><div class="field"><label>Wait for Exact Deployment</label><select id="waitDeploy"><option value="true">Yes</option><option value="false">No</option></select></div><div class="field"><label>Test Again After Deploy</label><select id="runAfterDeploy"><option value="true">Yes</option><option value="false">No</option></select></div><div class="field"><label>Auto-update Yardmaster</label><select id="autoUpdateOperator"><option value="true">Yes</option><option value="false">No</option></select></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px"><button class="m-btn" data-act="open-chatgpt">Open ChatGPT</button><button class="m-btn" data-act="push">Push Branch</button></div></div><div class="m-card" id="approvalCard"><h3>Automation</h3><div class="tiny">No approval needed in Automatic mode.</div></div>
    <div class="m-card" id="mActivityCard"><h3>Recent Activity</h3><div class="activity" id="activity"><div class="activity-row"><span>--</span><span class="dot"></span><span>Waiting for connection.</span></div></div></div>
  </div>
  <nav class="mobile-nav"><button class="active" data-mobile-target="mControlCard">Control</button><button data-mobile-target="mConsoleCard">Console</button><button data-mobile-target="mActivityCard">Activity</button><button data-mobile-target="approvalCard">Approve</button><button data-mobile-target="mSettingsCard">Settings</button></nav>
</section>

<div class="overlay show" id="overlay"><div class="connect"><img src="/yardmaster/yardmaster-logo.svg" alt="Yardmaster"><h2>Connect to your Yardmaster PC</h2><p><b>Secure phone sign-in is required before Yardmaster controls unlock.</b></p><p>On Windows, click <b>Start Remote Access</b>. Enter the Cloudflare tunnel URL and six-digit pairing code shown there, or unlock with your saved passkey.</p><div class="field"><label>Remote URL</label><input id="url" placeholder="https://...trycloudflare.com"></div><div class="field"><label>Pairing Code</label><input id="code" inputmode="numeric" maxlength="6" placeholder="123456"></div><div class="field"><label>Device Name</label><input id="device" value="My phone"></div><button class="button primary" style="width:100%;margin-top:12px" id="pair">Pair & Create Passkey</button><button class="button green" style="width:100%;margin-top:8px;display:none" id="unlock">Unlock with Passkey</button><div class="tiny" id="pairMsg"></div></div></div>
<div class="overlay" id="newWorkOverlay"><div class="connect"><h2>New 86 Chaos Work</h2><p>Describe the feature or change. Yardmaster will hand it off, apply the returned complete app, and run targeted/delta verification until it passes or reaches a safety stop.</p><div class="field"><label>What do you want implemented?</label><textarea id="mobileWorkTask" placeholder="Example: Add a vendor price comparison screen to Inventory and include release-gate coverage."></textarea></div><label class="work-check"><input type="checkbox" id="mobileWorkPush"><span>Push to <b>testing</b> automatically after tests pass</span></label><div class="m-controls"><button class="m-btn" id="cancelMobileWork">Cancel</button><button class="m-btn start" id="submitMobileWork">Hand Off & Walk Away</button></div><div class="tiny" id="mobileWorkMsg"></div></div></div>
<script is:inline>
const $=s=>document.querySelector(s);const KEY='yardmaster:';let installPrompt=null,consoleAutoScroll=true;const validHost=value=>/^[a-z0-9-]+\.trycloudflare\.com$/i.test(String(value||''));const validRemote=value=>/^https:\/\/[a-z0-9-]+\.trycloudflare\.com$/i.test(String(value||'').replace(/\/$/,''));let base=localStorage.getItem(KEY+'url')||'',deviceId=localStorage.getItem(KEY+'deviceId')||'',token=sessionStorage.getItem(KEY+'session')||'',state={};const mobile=matchMedia('(max-width:760px)').matches;
function pairingHints(){
  const here=new URL(location.href),query=here.searchParams,hash=new URLSearchParams(here.hash.replace(/^#/,''));
  const host=query.get('host')||hash.get('host')||'',remote=query.get('remote')||hash.get('remote')||'',code=query.get('code')||hash.get('code')||'';
  const scanned=validHost(host)?'https://'+host:(validRemote(remote)?remote.replace(/\/$/,''):'');
  return {remote:scanned,code:/^\d{6}$/.test(code)?code:''};
}
function applyPairingHints(){
  const hints=pairingHints();
  if(hints.remote){base=hints.remote;localStorage.setItem(KEY+'url',base)}
  const urlField=$('#url'),codeField=$('#code');
  if(urlField&&validRemote(base))urlField.value=base;
  if(codeField&&hints.code)codeField.value=hints.code;
  return hints;
}
applyPairingHints();addEventListener('DOMContentLoaded',applyPairingHints);addEventListener('pageshow',applyPairingHints);
addEventListener('beforeinstallprompt',e=>{e.preventDefault();installPrompt=e});
async function doInstall(){if(installPrompt){installPrompt.prompt();await installPrompt.userChoice;installPrompt=null}else alert('Use your browser menu and choose Add to Home Screen / Install app.')}
function b64url(v){const p='='.repeat((4-v.length%4)%4),b=(v+p).replace(/-/g,'+').replace(/_/g,'/'),raw=atob(b);return Uint8Array.from([...raw].map(c=>c.charCodeAt(0)))}
async function enableAlerts(){if(!base||!token){showPair();return}if(!('Notification'in window)||!('serviceWorker'in navigator)){alert('Web Push is not supported on this device.');return}const perm=await Notification.requestPermission();if(perm!=='granted'){alert('Notification permission was not granted.');return}try{const reg=await navigator.serviceWorker.ready;const key=await api('/api/push/key');let sub=await reg.pushManager.getSubscription();if(!sub)sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:b64url(key.publicKey)});await api('/api/push/subscribe',{method:'POST',body:JSON.stringify({subscription:sub.toJSON()})});alert('Yardmaster alerts are enabled on this device.')}catch(e){alert('Could not enable alerts: '+e.message)}}
$('#alertsBtn')?.addEventListener('click',enableAlerts);$('#installPwa')?.addEventListener('click',doInstall);$('#desktopInstallPwa')?.addEventListener('click',()=>alert('Open https://86chaos.com/yardmaster on your phone, then choose Add to Home Screen / Install app.'));
if('serviceWorker'in navigator)navigator.serviceWorker.register('/yardmaster/sw.js',{scope:'/yardmaster'}).catch(()=>{});
function b64ToBytes(v){const p='='.repeat((4-v.length%4)%4),raw=atob((v+p).replace(/-/g,'+').replace(/_/g,'/'));return Uint8Array.from([...raw].map(c=>c.charCodeAt(0)))}function bytesToB64(buf){let s='';for(const b of new Uint8Array(buf))s+=String.fromCharCode(b);return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}
function auth(){return token?{Authorization:'Bearer '+token}:{}}async function tunnelHealth(){if(!validRemote(base))return {ok:false,error:'Enter the secure trycloudflare.com URL shown by Yardmaster.'};try{const r=await fetch(base+'/api/remote/health',{headers:{'Content-Type':'application/json'}});if(!r.ok)return {ok:false,error:(await r.text())||('HTTP '+r.status)};return await r.json()}catch{return {ok:false,error:'The Cloudflare tunnel cannot reach your Yardmaster PC. Leave Yardmaster running and restart Remote Access on the PC.'}}}async function api(path,opt={}){if(!validRemote(base))throw new Error('Enter the secure trycloudflare.com URL shown by Yardmaster.');let r;try{r=await fetch(base+path,{...opt,headers:{'Content-Type':'application/json',...auth(),...(opt.headers||{})}})}catch{throw new Error('The Yardmaster tunnel is up in the PC UI, but this phone cannot reach its API. Restart Remote Access and try Pair This Phone Again.')}if(r.status===401){token='';sessionStorage.removeItem(KEY+'session')}if(!r.ok)throw new Error((await r.text())||('HTTP '+r.status));return r.json()}
function showPair(message=''){if(!mobile)return;applyPairingHints();document.body.classList.remove('ym-authenticated');document.body.classList.add('ym-auth-pending');$('#overlay').classList.add('show');if(validRemote(base)&&$('#url'))$('#url').value=base;const known=!!(base&&deviceId);$('#unlock').style.display=known?'inline-flex':'none';$('#pair').style.display='inline-flex';$('#pair').textContent=known?'Pair This Phone Again':'Pair & Create Passkey';$('#pairMsg').textContent=message||(known?'Use Unlock with Passkey, or pair this phone again with the fresh six-digit code from the PC.':'Pair this phone with the code shown on your Windows Yardmaster dashboard.')}function hidePair(){document.body.classList.remove('ym-auth-pending');document.body.classList.add('ym-authenticated');$('#overlay').classList.remove('show')}function clearStaleDevice(){deviceId='';token='';localStorage.removeItem(KEY+'deviceId');sessionStorage.removeItem(KEY+'session')}
function regOptions(o){return {...o,challenge:b64ToBytes(o.challenge),user:{...o.user,id:b64ToBytes(o.user.id)},excludeCredentials:(o.excludeCredentials||[]).map(c=>({...c,id:b64ToBytes(c.id)}))}}function authOptions(o){return {...o,challenge:b64ToBytes(o.challenge),allowCredentials:(o.allowCredentials||[]).map(c=>({...c,id:b64ToBytes(c.id)}))}}
function serializeRegistration(c){return {id:c.id,rawId:bytesToB64(c.rawId),type:c.type,response:{clientDataJSON:bytesToB64(c.response.clientDataJSON),attestationObject:bytesToB64(c.response.attestationObject),transports:c.response.getTransports?.()||[]},clientExtensionResults:c.getClientExtensionResults(),authenticatorAttachment:c.authenticatorAttachment}}
function serializeAuthentication(c){return {id:c.id,rawId:bytesToB64(c.rawId),type:c.type,response:{clientDataJSON:bytesToB64(c.response.clientDataJSON),authenticatorData:bytesToB64(c.response.authenticatorData),signature:bytesToB64(c.response.signature),userHandle:c.response.userHandle?bytesToB64(c.response.userHandle):null},clientExtensionResults:c.getClientExtensionResults(),authenticatorAttachment:c.authenticatorAttachment}}
async function unlockWithPasskey(){const entered=$('#url')?.value.trim().replace(/\/$/,'');if(entered){if(!validRemote(entered)){return void($('#pairMsg').textContent='Use the HTTPS trycloudflare.com URL shown by Yardmaster.')}if(entered!==base){base=entered;localStorage.setItem(KEY+'url',base)}}if(!base||!deviceId){showPair();return}if(!navigator.credentials){showPair('Passkeys are not supported on this device. Pair this phone again from a supported browser.');return}$('#pairMsg').textContent='Checking secure tunnel…';const health=await tunnelHealth();if(!health.ok){showPair(health.error);return}$('#pairMsg').textContent='Waiting for passkey…';try{const r=await fetch(base+'/api/passkey/auth/options',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({deviceId})});if(r.status===404){clearStaleDevice();showPair('This phone is no longer registered on the PC. Use the fresh six-digit code and Pair This Phone Again.');return}if(!r.ok)throw new Error(await r.text());const j=await r.json(),cred=await navigator.credentials.get({publicKey:authOptions(j.options)});const vr=await fetch(base+'/api/passkey/auth/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({authId:j.authId,credential:serializeAuthentication(cred)})});if(!vr.ok)throw new Error(await vr.text());const v=await vr.json();token=v.sessionToken;deviceId=v.deviceId||deviceId;localStorage.setItem(KEY+'deviceId',deviceId);sessionStorage.setItem(KEY+'session',token);await refresh()}catch(e){showPair('Unlock failed: '+e.message+' You can also Pair This Phone Again with the fresh PC code.')}}
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function render(s){
  state=s;
  const r=s.run||{},c=s.config||{},n=r.counts||{},p=Math.max(0,Math.min(100,r.progress||0));
  const remoteState=s.remote?.phoneConnected?'connected':(s.remote?.status||(s.remote?.active?'tunnel-ready':'local'));
  const be=$('#branch');
  if(be&&document.activeElement!==be){const list=[...new Set([...(s.branches||[]),c.branch].filter(Boolean))];be.innerHTML=list.map(b=>'<option value="'+esc(b)+'">'+esc(b)+'</option>').join('');be.value=c.branch||'testing'}
  $('#mPc').textContent='PC Online • '+({local:'Local',connecting:'Connecting','tunnel-ready':'Tunnel Ready',connected:'Phone Connected',error:'Remote Error'}[remoteState]||remoteState);
  $('#mConn').textContent=s.machineName+(s.remote?.url?' • '+s.remote.url:'')+(s.remote?.error?' • '+s.remote.error:'');
  $('#mConn').classList.toggle('remote-error',remoteState==='error');
  $('#mTitle').textContent=r.title||'Ready for work';$('#mTest').textContent=r.currentTest||'Idle';$('#mPct').textContent=p+'%';$('#mBar').style.width=p+'%';$('#mPass').textContent=n.pass||0;$('#mFail').textContent=n.fail||0;$('#mSkip').textContent=n.skip||0;
  const consoleLines=(r.log||[]).slice(-220),consoleEl=$('#mConsole'),activityTail=(s.activity||[]).slice(-6).map(x=>'['+new Date(x.at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit'})+'] '+x.message);
  if($('#mConsoleState'))$('#mConsoleState').textContent=r.state||'idle';
  if($('#mConsoleCommand'))$('#mConsoleCommand').textContent=r.command?('$ '+r.command+(r.cwd?' • '+r.cwd:'')):'No command running.';
  if(consoleEl){const output=consoleLines.length?consoleLines.join('\n'):(activityTail.length?activityTail.join('\n'):'Yardmaster ready.');if(consoleEl.textContent!==output)consoleEl.textContent=output;if(consoleAutoScroll)requestAnimationFrame(()=>{consoleEl.scrollTop=consoleEl.scrollHeight})}
  for(const [id,v] of [['branch',c.branch],['testingUrl',c.testingUrl],['testType',c.testType],['chatMode',c.chatMode],['model',c.model],['thinkingEffort',c.thinkingEffort],['repoMode',c.repoUpdateMode],['maxRepairs',String(c.maxRepairAttempts??25)],['autoHandoff',String(c.autoHandoff!==false)],['autoPush',String(!!c.autoPush)],['waitDeploy',String(c.waitForDeploy!==false)],['runAfterDeploy',String(c.runAfterDeploy!==false)],['autoUpdateOperator',String(c.autoUpdateOperator!==false)]])if($('#'+id)&&document.activeElement!==$('#'+id))$('#'+id).value=v||$('#'+id).value;
  const wf=s.workflow||{},ac=$('#approvalCard');
  if(ac){if(wf.approval?.type==='repair'&&wf.pendingRepair)ac.innerHTML='<h3>Repair Ready</h3><div class="tiny">Manual Ask Me mode is enabled. Apply the downloaded repair and test it?</div><div class="m-controls"><button class="m-btn start" data-act="approve-repair">Approve</button><button class="m-btn stop" data-act="reject-repair">Reject</button></div>';else if(wf.state==='waiting-login')ac.innerHTML='<h3>ChatGPT Sign-in Needed</h3><div class="tiny">Sign in once in the Yardmaster ChatGPT window on the PC.</div><button class="m-btn" data-act="resume-handoff" style="width:100%;margin-top:10px">Resume Handoff</button>';else ac.innerHTML='<h3>Automation</h3><div class="tiny">Workflow: '+esc(wf.state||'idle')+(c.repoUpdateMode==='automatic'?' • Repairs apply and retest automatically.':'')+'</div>'}
  $('#activity').innerHTML=(s.activity||[]).slice(-12).reverse().map(x=>'<div class="activity-row"><span>'+new Date(x.at).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+'</span><span class="dot" style="background:'+(x.level==='error'?'#ef6666':x.level==='warn'?'#e6a348':'#38d77f')+'"></span><span>'+esc(x.message)+'</span></div>').join('')||'<div class="activity-row"><span>--</span><span class="dot"></span><span>No activity yet.</span></div>';
}
async function refresh(){if(!mobile)return;if(!base){showPair('Enter the secure Remote Access URL shown by Yardmaster on your PC.');return}const health=await tunnelHealth();if(!health.ok){showPair(health.error);return}if(!deviceId||!token){showPair(deviceId?'Tunnel reached. Unlock with your passkey, or Pair This Phone Again.':'Tunnel reached. Enter the fresh six-digit pairing code from the PC.');return}try{const authenticated=await api('/api/status');render(authenticated);hidePair()}catch(error){showPair(error.message||'Remote authentication failed.')}}
$('#unlock')?.addEventListener('click',unlockWithPasskey);$('#pair')?.addEventListener('click',async()=>{const u=$('#url').value.trim().replace(/\/$/,''),code=$('#code').value.trim(),device=$('#device').value.trim()||'My phone';if(!validRemote(u)){$('#pairMsg').textContent='Use the HTTPS trycloudflare.com URL shown by Yardmaster.';return}if(!navigator.credentials){$('#pairMsg').textContent='This device does not support passkeys.';return}$('#pairMsg').textContent='Checking tunnel…';try{base=u;localStorage.setItem(KEY+'url',u);const health=await tunnelHealth();if(!health.ok)throw new Error(health.error);$('#pairMsg').textContent='Creating passkey…';const r=await fetch(u+'/api/passkey/register/options',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code,deviceName:device})});if(!r.ok)throw new Error(await r.text());const j=await r.json(),cred=await navigator.credentials.create({publicKey:regOptions(j.options)});const vr=await fetch(u+'/api/passkey/register/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({registrationId:j.registrationId,credential:serializeRegistration(cred)})});if(!vr.ok)throw new Error(await vr.text());const v=await vr.json();base=u;deviceId=v.deviceId;token=v.sessionToken;localStorage.setItem(KEY+'url',u);localStorage.setItem(KEY+'deviceId',deviceId);sessionStorage.setItem(KEY+'session',token);history.replaceState(null,'','/yardmaster');hidePair();refresh()}catch(e){$('#pairMsg').textContent='Pairing failed: '+e.message}});
document.addEventListener('click',async e=>{const b=e.target.closest?.('[data-act]');if(!b)return;try{await api('/api/action',{method:'POST',body:JSON.stringify({action:b.dataset.act})});refresh()}catch(err){alert(err.message)}});
for(const [id,key,type] of [['branch','branch','text'],['testingUrl','testingUrl','text'],['testType','testType','text'],['chatMode','chatMode','text'],['model','model','text'],['thinkingEffort','thinkingEffort','text'],['repoMode','repoUpdateMode','text'],['maxRepairs','maxRepairAttempts','number'],['autoHandoff','autoHandoff','bool'],['autoPush','autoPush','bool'],['waitDeploy','waitForDeploy','bool'],['runAfterDeploy','runAfterDeploy','bool'],['autoUpdateOperator','autoUpdateOperator','bool']])$('#'+id)?.addEventListener('change',async e=>{let value=e.target.value;if(type==='number')value=Number(value);if(type==='bool')value=value==='true';try{await api('/api/config',{method:'POST',body:JSON.stringify({[key]:value})});refresh()}catch(err){alert(err.message)}});
$('#consoleAutoScroll')?.addEventListener('click',()=>{consoleAutoScroll=!consoleAutoScroll;$('#consoleAutoScroll').textContent='Auto-scroll: '+(consoleAutoScroll?'On':'Off');if(consoleAutoScroll&&$('#mConsole'))$('#mConsole').scrollTop=$('#mConsole').scrollHeight});
$('#copyConsole')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText($('#mConsole')?.textContent||'');const b=$('#copyConsole');b.textContent='Copied';setTimeout(()=>b.textContent='Copy',900)}catch{alert('Could not copy the console output on this browser.')}});
for(const button of [$('#mobileNewWorkControl'),$('#mobileNewWork')])button?.addEventListener('click',()=>$('#newWorkOverlay')?.classList.add('show'));
$('#cancelMobileWork')?.addEventListener('click',()=>$('#newWorkOverlay')?.classList.remove('show'));
$('#submitMobileWork')?.addEventListener('click',async()=>{const task=$('#mobileWorkTask')?.value.trim()||'',message=$('#mobileWorkMsg'),button=$('#submitMobileWork');if(!task){message.textContent='Describe what you want implemented first.';return}try{button.disabled=true;button.textContent='Handing off…';const accepted=await api('/api/action',{method:'POST',body:JSON.stringify({action:'new-implementation',taskPrompt:task,pushWhenPassed:!!$('#mobileWorkPush')?.checked})});if(accepted?.runsOn!=='windows-pc')throw new Error('The Windows Yardmaster did not confirm the remote job.');message.textContent='Accepted by your Windows Yardmaster. The PC is running this work now.';$('#mobileWorkTask').value='';setTimeout(()=>$('#newWorkOverlay')?.classList.remove('show'),650);await refresh()}catch(error){message.textContent=error.message}finally{button.disabled=false;button.textContent='Hand Off & Walk Away'}});
document.addEventListener('click',e=>{const b=e.target.closest?.('[data-mobile-target]');if(!b)return;document.querySelectorAll('.mobile-nav button').forEach(x=>x.classList.toggle('active',x===b));document.getElementById(b.dataset.mobileTarget)?.scrollIntoView({behavior:'smooth',block:'start'})});
refresh();setInterval(refresh,2500);
</script>
</body></html>
