---
const title='Yardmaster | Local-first workflow control';
const description='Yardmaster is a local-first Windows operator with a secure mobile PWA remote for tests, Git, ChatGPT, and deployments.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#071525" />
<link rel="manifest" href="/yardmaster/manifest.webmanifest" />
<link rel="icon" href="/yardmaster/yardmaster-icon.svg" />
<link rel="apple-touch-icon" href="/yardmaster/yardmaster-icon.svg" />
<style is:inline>
:root{--bg:#061321;--panel:#0b1c2d;--panel2:#102438;--line:#1d354a;--text:#f6f4ef;--muted:#8fa0ae;--copper:#c97f46;--copper2:#e5a16d;--green:#34c878;--red:#d95b5b;--steel:#b9c2c9}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 68% -10%,#173249 0,#081a29 36%,#05111c 72%);color:var(--text);font-family:Inter,Segoe UI,Arial,sans-serif}body:before{content:"";position:fixed;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 0 75%,#c97f4608 75% 76%,transparent 76%)}a{color:inherit}.desktop{min-height:100vh;padding:28px 24px 42px;display:grid;place-items:center}.desktop-inner{width:min(1180px,100%)}.brand{width:min(560px,72vw);display:block;margin-bottom:16px}.topnote{color:#a4b2bd;letter-spacing:.12em;text-transform:uppercase;font-size:12px}.hero{display:grid;grid-template-columns:1fr 460px;gap:34px;align-items:center}.copy h1{font-size:clamp(42px,6vw,80px);line-height:.96;margin:12px 0 18px;max-width:760px}.copy h1 span{color:#e59e69}.copy p{font-size:18px;color:#a7b6c1;line-height:1.6;max-width:650px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0}.button{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border-radius:12px;padding:14px 20px;font-weight:800;border:1px solid #2f4b60;background:#14293a;color:white;cursor:pointer}.button.primary{background:linear-gradient(135deg,#a55e39,#d98a54);border-color:#e19a68}.button.green{background:linear-gradient(135deg,#177d4e,#2cca79);border-color:#4ce29a}.button.ghost{background:#0a1927}.note{font-size:12px;color:#8494a0}.preview{border:1px solid #264158;border-radius:22px;background:linear-gradient(180deg,#0d2133,#081724);box-shadow:0 28px 100px #0009;padding:18px;position:relative;overflow:hidden}.preview:after{content:"";position:absolute;right:-60px;bottom:-60px;width:220px;height:220px;border:1px solid #c97f4633;border-radius:50%}.preview-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.status{font-size:12px;color:#73e9a6}.panel{background:#091a29;border:1px solid #1d3850;border-radius:15px;padding:15px;margin-top:10px}.eyebrow{font-size:11px;color:#8fa1ae;letter-spacing:.12em;text-transform:uppercase}.panel h3{margin:6px 0 12px}.rail{height:76px}.rail svg{width:100%;height:100%}.progress{height:10px;background:#1a3143;border-radius:999px;overflow:hidden}.progress div{width:66%;height:100%;background:linear-gradient(90deg,#c97f46,#e9ad7b,#51dc8d)}.mini-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px}.mini{background:#071522;border:1px solid #173247;border-radius:10px;padding:9px;font-size:11px}.mini b{display:block;font-size:18px}.pass b{color:#59e299}.fail b{color:#ff7b7b}.download-card{margin-top:22px;padding:18px;border:1px solid #24435a;background:#091a29;border-radius:16px;display:flex;justify-content:space-between;gap:16px;align-items:center}.download-card small{color:#91a1ad}.mobile{display:none;min-height:100vh}.m-head{display:flex;align-items:center;justify-content:space-between;padding:15px;border-bottom:1px solid #183247}.m-head img{width:190px}.m-content{padding:14px;display:grid;gap:12px}.m-card{background:#0b1d2d;border:1px solid #1d3850;border-radius:15px;padding:15px}.m-card h3{margin:0 0 8px}.m-controls{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:8px;margin-top:13px}.m-btn{padding:12px 7px;border-radius:10px;border:1px solid #2c465d;background:#13273a;color:white;font-weight:800}.m-btn.start{background:linear-gradient(135deg,#168b56,#2ac978);border-color:#43e99d}.m-btn.stop{background:#3a151c;border-color:#8a353e;color:#ffaaa9}.field{display:grid;gap:7px;margin-top:10px}.field label{font-size:11px;color:#8da0ad}.field input,.field select{width:100%;background:#071522;border:1px solid #28465d;color:#fff;border-radius:10px;padding:11px}.activity{display:grid;gap:8px;font-size:12px;color:#a7b3bd}.activity-row{display:grid;grid-template-columns:54px 8px 1fr;gap:8px}.dot{width:7px;height:7px;border-radius:50%;background:#38d77f;margin-top:4px}.overlay{position:fixed;inset:0;background:#061321;z-index:50;padding:20px;display:none;align-items:center;justify-content:center}.overlay.show{display:flex}.connect{width:min(430px,100%);background:#0b1c2d;border:1px solid #28425a;border-radius:20px;padding:22px}.connect img{width:220px;display:block;margin:0 auto 10px}.connect h2{text-align:center}.connect p{color:#9aacb9}.tiny{font-size:11px;color:#8495a1}.install-banner{background:#102824;border:1px solid #2a5a49;color:#d5f2e1;border-radius:12px;padding:12px;margin-top:12px}.mobile-nav{position:sticky;bottom:0;display:grid;grid-template-columns:repeat(4,1fr);background:#071523f2;border-top:1px solid #1e374b}.mobile-nav button{background:none;border:0;color:#93a2ae;padding:12px 4px;font-size:11px}.mobile-nav button:first-child{color:#f0a56c}@media(max-width:760px){.desktop{display:none}.mobile{display:block}}@media(min-width:761px){.overlay{display:none!important}} 
</style>
</head>
<body>
<section class="desktop">
  <div class="desktop-inner">
    <img class="brand" src="/yardmaster/yardmaster-logo.svg" alt="Yardmaster" />
    <div class="hero">
      <div class="copy">
        <div class="topnote">Local-first desktop operator + secure PWA remote</div>
        <h1>Keep the work <span>moving.</span></h1>
        <p>Yardmaster runs your approved local test commands, watches progress, controls Git and deployment handoffs, and gives you a secure remote control from your phone. Operational history stays on your Windows PC.</p>
        <div class="actions">
          <a class="button primary" href="/yardmaster/Install-Yardmaster.cmd" download>Download Windows Preview</a>
          <button class="button green" id="desktopInstallPwa">Install Mobile PWA</button>
        </div>
        <div class="note">Preview 0.1.0 • Windows requires Node.js 22+ and your GitHub sign-in for this private preview • Remote access uses an optional Cloudflare Quick Tunnel.</div>
        <div class="download-card"><div><b>Mobile PWA</b><br><small>Open this page on your phone and choose Add to Home Screen. Pair it from the Windows dashboard.</small></div><span>📱</span></div>
      </div>
      <div class="preview">
        <div class="preview-top"><img src="/yardmaster/yardmaster-icon.svg" width="54" height="54"><span class="status">● PC Online</span></div>
        <div class="panel"><div class="eyebrow">Current Run • Running</div><h3>Full Release Gate</h3><div class="rail"><svg viewBox="0 0 500 80" preserveAspectRatio="none"><path d="M0 12 H175 C225 12 235 40 270 40 H500" stroke="#c97f46" stroke-width="7" fill="none"/><path d="M0 30 H185 C225 30 235 40 270 40 H500" stroke="#bdc7ce" stroke-width="7" fill="none"/><path d="M0 48 H188 C225 48 235 40 270 40 H500" stroke="#36c777" stroke-width="7" fill="none"/><path d="M0 66 H175 C225 66 235 40 270 40 H500" stroke="#818d97" stroke-width="7" fill="none"/><circle cx="283" cy="40" r="12" fill="#071525" stroke="#d08a56" stroke-width="6"/></svg></div><div class="progress"><div></div></div><div class="mini-grid"><div class="mini pass">Passed<b>248</b></div><div class="mini fail">Failed<b>0</b></div><div class="mini">Skipped<b>7</b></div></div></div>
        <div class="panel"><div class="eyebrow">Current stage</div><h3>Waiting for exact Vercel deployment</h3><div class="tiny">Branch: testing • Repo update: Ask Me • ChatGPT mode: Work</div></div>
      </div>
    </div>
  </div>
</section>

<section class="mobile">
  <header class="m-head"><img src="/yardmaster/yardmaster-logo.svg" alt="Yardmaster"><div style="display:flex;gap:6px"><button class="m-btn" id="alertsBtn">🔔 Alerts</button><button class="m-btn" id="installPwa">＋ Install</button></div></header>
  <div class="m-content">
    <div class="m-card"><span style="color:#58e79b">●</span> <b id="mPc">Not connected</b><div class="tiny" id="mConn">Pair with your Windows Yardmaster operator.</div></div>
    <div class="m-card"><div class="eyebrow">Current Run</div><h3 id="mTitle">Ready for work</h3><div><span id="mTest">Idle</span><b style="float:right" id="mPct">0%</b></div><div class="progress" style="margin-top:9px"><div id="mBar" style="width:0%"></div></div><div class="mini-grid"><div class="mini pass">Pass<b id="mPass">0</b></div><div class="mini fail">Fail<b id="mFail">0</b></div><div class="mini">Skip<b id="mSkip">0</b></div></div><div class="m-controls"><button class="m-btn start" data-act="start">▶ Start</button><button class="m-btn" data-act="pause">Ⅱ Pause</button><button class="m-btn stop" data-act="stop">■ Stop</button></div></div>
    <div class="m-card"><div class="field"><label>Branch</label><select id="branch"><option>testing</option></select></div><div class="field"><label>Test Type</label><select id="testType"><option value="delta">Delta / Targeted</option><option value="full">Full Release Gate</option><option value="targeted">Current Release Targeted</option></select></div><div class="field"><label>ChatGPT Mode</label><select id="chatMode"><option>Work</option><option>Chat</option></select></div><div class="field"><label>Model</label><select id="model"><option>GPT-5.6 Sol</option><option>GPT-5.6 Luna</option><option>GPT-5.6 Pro</option></select></div><div class="field"><label>Local Repo Update</label><select id="repoMode"><option value="ask">Ask Me</option><option value="automatic">Automatic</option><option value="never">Never</option></select></div><div class="field"><label>Automatic Repair Attempts</label><select id="maxRepairs"><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></div><div class="field"><label>Send Failures to ChatGPT</label><select id="autoHandoff"><option value="true">Yes</option><option value="false">No</option></select></div><div class="field"><label>Push After Pass</label><select id="autoPush"><option value="false">No</option><option value="true">Yes</option></select></div><div class="field"><label>Wait for Exact Deployment</label><select id="waitDeploy"><option value="true">Yes</option><option value="false">No</option></select></div><div class="field"><label>Test Again After Deploy</label><select id="runAfterDeploy"><option value="true">Yes</option><option value="false">No</option></select></div><div class="field"><label>Auto-update Yardmaster</label><select id="autoUpdateOperator"><option value="true">Yes</option><option value="false">No</option></select></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px"><button class="m-btn" data-act="open-chatgpt">Open ChatGPT</button><button class="m-btn" data-act="push">Push Branch</button></div></div><div class="m-card" id="approvalCard"><h3>Approvals</h3><div class="tiny">No approval needed.</div></div>
    <div class="m-card"><h3>Recent Activity</h3><div class="activity" id="activity"><div class="activity-row"><span>--</span><span class="dot"></span><span>Waiting for connection.</span></div></div></div>
  </div>
  <nav class="mobile-nav"><button>Control</button><button>Activity</button><button>Approvals</button><button>Settings</button></nav>
</section>

<div class="overlay" id="overlay"><div class="connect"><img src="/yardmaster/yardmaster-logo.svg" alt="Yardmaster"><h2>Connect to your Yardmaster PC</h2><p>On Windows, click <b>Start Remote Access</b>. Enter the Cloudflare tunnel URL and six-digit pairing code shown there.</p><div class="field"><label>Remote URL</label><input id="url" placeholder="https://...trycloudflare.com"></div><div class="field"><label>Pairing Code</label><input id="code" inputmode="numeric" maxlength="6" placeholder="123456"></div><div class="field"><label>Device Name</label><input id="device" value="My phone"></div><button class="button primary" style="width:100%;margin-top:12px" id="pair">Pair & Create Passkey</button><button class="button green" style="width:100%;margin-top:8px;display:none" id="unlock">Unlock with Passkey</button><div class="tiny" id="pairMsg"></div></div></div>
<script is:inline>
const $=s=>document.querySelector(s);const KEY='yardmaster:';let installPrompt=null;let base=localStorage.getItem(KEY+'url')||'',deviceId=localStorage.getItem(KEY+'deviceId')||'',token=sessionStorage.getItem(KEY+'session')||'',state={};const mobile=matchMedia('(max-width:760px)').matches;
addEventListener('beforeinstallprompt',e=>{e.preventDefault();installPrompt=e});
async function doInstall(){if(installPrompt){installPrompt.prompt();await installPrompt.userChoice;installPrompt=null}else alert('Use your browser menu and choose Add to Home Screen / Install app.')}
function b64url(v){const p='='.repeat((4-v.length%4)%4),b=(v+p).replace(/-/g,'+').replace(/_/g,'/'),raw=atob(b);return Uint8Array.from([...raw].map(c=>c.charCodeAt(0)))}
async function enableAlerts(){if(!base||!token){showPair();return}if(!('Notification'in window)||!('serviceWorker'in navigator)){alert('Web Push is not supported on this device.');return}const perm=await Notification.requestPermission();if(perm!=='granted'){alert('Notification permission was not granted.');return}try{const reg=await navigator.serviceWorker.ready;const key=await api('/api/push/key');let sub=await reg.pushManager.getSubscription();if(!sub)sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:b64url(key.publicKey)});await api('/api/push/subscribe',{method:'POST',body:JSON.stringify({subscription:sub.toJSON()})});alert('Yardmaster alerts are enabled on this device.')}catch(e){alert('Could not enable alerts: '+e.message)}}
$('#alertsBtn')?.addEventListener('click',enableAlerts);$('#installPwa')?.addEventListener('click',doInstall);$('#desktopInstallPwa')?.addEventListener('click',()=>alert('Open https://86chaos.com/yardmaster on your phone, then choose Add to Home Screen / Install app.'));
if('serviceWorker'in navigator)navigator.serviceWorker.register('/yardmaster/sw.js',{scope:'/yardmaster'}).catch(()=>{});
function b64ToBytes(v){const p='='.repeat((4-v.length%4)%4),raw=atob((v+p).replace(/-/g,'+').replace(/_/g,'/'));return Uint8Array.from([...raw].map(c=>c.charCodeAt(0)))}function bytesToB64(buf){let s='';for(const b of new Uint8Array(buf))s+=String.fromCharCode(b);return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}
function auth(){return token?{Authorization:'Bearer '+token}:{}}async function api(path,opt={}){if(!base)throw new Error('Not paired');const r=await fetch(base+path,{...opt,headers:{'Content-Type':'application/json',...auth(),...(opt.headers||{})}});if(r.status===401){token='';sessionStorage.removeItem(KEY+'session')}if(!r.ok)throw new Error(await r.text());return r.json()}
function showPair(){if(!mobile)return;$('#overlay').classList.add('show');if(base&&!$('#url').value)$('#url').value=base;const known=!!(base&&deviceId);$('#unlock').style.display=known?'inline-flex':'none';$('#pair').style.display=known?'none':'inline-flex';$('#pairMsg').textContent=known?'Confirm your passkey to unlock Yardmaster.':'Pair this phone with the code shown on your Windows Yardmaster dashboard.'}function hidePair(){$('#overlay').classList.remove('show')}
function regOptions(o){return {...o,challenge:b64ToBytes(o.challenge),user:{...o.user,id:b64ToBytes(o.user.id)},excludeCredentials:(o.excludeCredentials||[]).map(c=>({...c,id:b64ToBytes(c.id)}))}}function authOptions(o){return {...o,challenge:b64ToBytes(o.challenge),allowCredentials:(o.allowCredentials||[]).map(c=>({...c,id:b64ToBytes(c.id)}))}}
function serializeRegistration(c){return {id:c.id,rawId:bytesToB64(c.rawId),type:c.type,response:{clientDataJSON:bytesToB64(c.response.clientDataJSON),attestationObject:bytesToB64(c.response.attestationObject),transports:c.response.getTransports?.()||[]},clientExtensionResults:c.getClientExtensionResults(),authenticatorAttachment:c.authenticatorAttachment}}
function serializeAuthentication(c){return {id:c.id,rawId:bytesToB64(c.rawId),type:c.type,response:{clientDataJSON:bytesToB64(c.response.clientDataJSON),authenticatorData:bytesToB64(c.response.authenticatorData),signature:bytesToB64(c.response.signature),userHandle:c.response.userHandle?bytesToB64(c.response.userHandle):null},clientExtensionResults:c.getClientExtensionResults(),authenticatorAttachment:c.authenticatorAttachment}}
async function unlockWithPasskey(){const entered=$('#url')?.value.trim().replace(/\/$/,'');if(entered&&entered!==base){base=entered;localStorage.setItem(KEY+'url',base)}if(!base||!deviceId){showPair();return}if(!navigator.credentials){alert('Passkeys are not supported on this device.');return}$('#pairMsg').textContent='Waiting for passkey…';try{const r=await fetch(base+'/api/passkey/auth/options',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({deviceId})});if(!r.ok)throw new Error(await r.text());const j=await r.json(),cred=await navigator.credentials.get({publicKey:authOptions(j.options)});const vr=await fetch(base+'/api/passkey/auth/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({authId:j.authId,credential:serializeAuthentication(cred)})});if(!vr.ok)throw new Error(await vr.text());const v=await vr.json();token=v.sessionToken;sessionStorage.setItem(KEY+'session',token);hidePair();await refresh()}catch(e){$('#pairMsg').textContent='Unlock failed: '+e.message}}
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function render(s){state=s;const r=s.run||{},c=s.config||{},n=r.counts||{},p=Math.max(0,Math.min(100,r.progress||0));const be=$('#branch');if(be&&document.activeElement!==be){const list=[...new Set([...(s.branches||[]),c.branch].filter(Boolean))];be.innerHTML=list.map(b=>'<option value=\"'+esc(b)+'\">'+esc(b)+'</option>').join('');be.value=c.branch||'testing'}$('#mPc').textContent='PC Online';$('#mConn').textContent=s.machineName+(s.remote?.url?' • Remote linked':'');$('#mTitle').textContent=r.title||'Ready for work';$('#mTest').textContent=r.currentTest||'Idle';$('#mPct').textContent=p+'%';$('#mBar').style.width=p+'%';$('#mPass').textContent=n.pass||0;$('#mFail').textContent=n.fail||0;$('#mSkip').textContent=n.skip||0;for(const [id,v] of [['branch',c.branch],['testType',c.testType],['chatMode',c.chatMode],['model',c.model],['repoMode',c.repoUpdateMode],['maxRepairs',String(c.maxRepairAttempts||2)],['autoHandoff',String(c.autoHandoff!==false)],['autoPush',String(!!c.autoPush)],['waitDeploy',String(c.waitForDeploy!==false)],['runAfterDeploy',String(c.runAfterDeploy!==false)],['autoUpdateOperator',String(c.autoUpdateOperator!==false)]])if($( '#'+id)&&document.activeElement!==$('#'+id))$('#'+id).value=v||$('#'+id).value;const wf=s.workflow||{};const ac=$('#approvalCard');if(ac){if(wf.approval?.type==='repair'&&wf.pendingRepair)ac.innerHTML='<h3>Repair Ready</h3><div class="tiny">ChatGPT returned a repaired application ZIP. Apply it to the local repo and test it?</div><div class="m-controls"><button class="m-btn start" data-act="approve-repair">Approve</button><button class="m-btn stop" data-act="reject-repair">Reject</button></div>';else if(wf.state==='waiting-login')ac.innerHTML='<h3>ChatGPT Sign-in Needed</h3><div class="tiny">Sign in once in the Yardmaster Edge window on the PC.</div><button class="m-btn" data-act="resume-handoff" style="width:100%;margin-top:10px">Resume Handoff</button>';else ac.innerHTML='<h3>Approvals</h3><div class="tiny">Workflow: '+esc(wf.state||'idle')+'</div>'}$('#activity').innerHTML=(s.activity||[]).slice(-12).reverse().map(x=>'<div class="activity-row"><span>'+new Date(x.at).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+'</span><span class="dot" style="background:'+(x.level==='error'?'#ef6666':x.level==='warn'?'#e6a348':'#38d77f')+'"></span><span>'+esc(x.message)+'</span></div>').join('')||'<div class="activity-row"><span>--</span><span class="dot"></span><span>No activity yet.</span></div>'}
async function refresh(){if(!mobile)return;if(!base||!deviceId||!token){showPair();return}try{render(await api('/api/status'));hidePair()}catch{showPair()}}
$('#unlock')?.addEventListener('click',unlockWithPasskey);$('#pair')?.addEventListener('click',async()=>{const u=$('#url').value.trim().replace(/\/$/,''),code=$('#code').value.trim(),device=$('#device').value.trim()||'My phone';if(!navigator.credentials){$('#pairMsg').textContent='This device does not support passkeys.';return}$('#pairMsg').textContent='Creating passkey…';try{const r=await fetch(u+'/api/passkey/register/options',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code,deviceName:device})});if(!r.ok)throw new Error(await r.text());const j=await r.json(),cred=await navigator.credentials.create({publicKey:regOptions(j.options)});const vr=await fetch(u+'/api/passkey/register/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({registrationId:j.registrationId,credential:serializeRegistration(cred)})});if(!vr.ok)throw new Error(await vr.text());const v=await vr.json();base=u;deviceId=v.deviceId;token=v.sessionToken;localStorage.setItem(KEY+'url',u);localStorage.setItem(KEY+'deviceId',deviceId);sessionStorage.setItem(KEY+'session',token);hidePair();refresh()}catch(e){$('#pairMsg').textContent='Pairing failed: '+e.message}});
document.addEventListener('click',async e=>{const b=e.target.closest?.('[data-act]');if(!b)return;try{await api('/api/action',{method:'POST',body:JSON.stringify({action:b.dataset.act})});refresh()}catch(err){alert(err.message)}});
for(const [id,key,type] of [['branch','branch','text'],['testType','testType','text'],['chatMode','chatMode','text'],['model','model','text'],['repoMode','repoUpdateMode','text'],['maxRepairs','maxRepairAttempts','number'],['autoHandoff','autoHandoff','bool'],['autoPush','autoPush','bool'],['waitDeploy','waitForDeploy','bool'],['runAfterDeploy','runAfterDeploy','bool'],['autoUpdateOperator','autoUpdateOperator','bool']])$('#'+id)?.addEventListener('change',async e=>{let value=e.target.value;if(type==='number')value=Number(value);if(type==='bool')value=value==='true';try{await api('/api/config',{method:'POST',body:JSON.stringify({[key]:value})});refresh()}catch(err){alert(err.message)}});
refresh();setInterval(refresh,2500);
</script>
</body></html>