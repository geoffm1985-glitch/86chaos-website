---
/**
 * Temporary, isolated Chilton App Works preview.
 * Intentionally does not import or modify any 86 Chaos product components.
 * The official brand image is sourced from the owner's existing Chilton App Works preview.
 */
const logoUrl = 'https://chilton-app-works-business-website-y0yj33.v2.appdeploy.ai/resources/chilton-app-works-logo.jpg';
const packages = [
  {
    name: 'One-Page Starter',
    price: '$149',
    blurb: 'A sharp first impression without the big bill.',
    features: [
      'One mobile-friendly page',
      'Professional design from a tested template',
      'Business overview and contact links',
      'Basic search-friendly page setup',
      'One revision round',
    ],
    note: 'Customer supplies business copy, logo and photos. Domain and hosting are separate.',
    subject: 'One-Page Starter website'
  },
  {
    name: 'Small Business',
    price: '$349',
    blurb: 'A little more room for your story.',
    features: [
      'Up to three responsive pages',
      'Business-appropriate colors and branding',
      'Services, about and contact information',
      'Basic local-search setup',
      'One revision round',
    ],
    note: 'Customer-supplied content. Extra design, photography, forms or integrations quoted first.',
    subject: 'Small Business website'
  },
  {
    name: 'Business Plus',
    price: '$599',
    blurb: 'A polished home for a growing business.',
    features: [
      'Up to five responsive pages',
      'More customized layout and sections',
      'Photo gallery or service showcase',
      'Contact links and basic local SEO',
      'Two revision rounds',
    ],
    note: 'Complex features, online payments, bookings and external services quoted separately.',
    subject: 'Business Plus website'
  }
];
const maintenance = [
  { name:'Basic Hosting', price:'$19', items:['Managed static hosting for eligible sites', 'SSL and uptime monitoring', 'Content changes quoted separately'] },
  { name:'Managed Care', price:'$39', items:['Basic Hosting benefits', 'Up to 15 minutes of minor edits per month', 'Routine website checks'] },
  { name:'Premium Care', price:'$69', items:['Basic Hosting benefits', 'Up to 30 minutes of minor edits per month', 'Priority routine requests'] }
];
const faq = [
  ['Is $149 really the website price?', 'Yes, for a tightly scoped one-page website with customer-provided content, a tested design template and one revision round. Domain registration, hosting, email subscriptions and optional extra features are separate.'],
  ['Do I have to buy monthly maintenance?', 'No. Care plans are optional and month-to-month, with 30 days notice for cancellation. If you choose another host, the handoff and hosting arrangements will be spelled out in your proposal.'],
  ['Will I own my domain and website?', 'Your domain is registered in your name. You own the final website deliverables specified in the agreement, and you can move them to another provider without an artificial lock-in.'],
  ['Can I have an address like hello@mybusiness.com?', 'Absolutely. First-mailbox setup starts at $49 one-time. Domain costs and paid mailbox licenses from your chosen email provider are separate. You ordinarily pay the provider directly.'],
  ['Can you make a custom app?', 'Yes. Business dashboards, internal workflows, customer portals, automations and other custom applications are scoped and quoted individually, including any third-party or ongoing infrastructure costs.'],
  ['What costs extra?', 'New pages start at $99 each. Extensive copywriting, photography, booking or payment systems, databases, software integrations, additional revisions and usage-heavy hosting are quoted and approved before work begins.']
];
const mail=(subject)=>'mailto:Geoffrey@86chaos.com?subject='+encodeURIComponent('Chilton App Works inquiry: '+subject);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#0a3353"/>
  <meta name="robots" content="noindex,nofollow"/>
  <meta name="description" content="A temporary preview of Chilton App Works' affordable professional websites, custom application development and optional website care. Websites starting at $149, plus separately disclosed domain and service costs."/>
  <title>Chilton App Works | Websites Starting at $149 · Temporary Preview</title>
</head>
<body>
  <a href="#main" class="skip">Skip to content</a>
  <div class="demo-banner">
    <div class="page-width demo-banner-inner"><span><span class="light-dot" aria-hidden="true"></span> Temporary Chilton App Works preview hosted on 86chaos.com</span><a href="https://www.86chaos.com/">Visit 86 Chaos <span aria-hidden="true">↗</span></a></div>
  </div>
  <header class="masthead">
    <div class="page-width masthead-inner">
      <a href="#home" class="brand" aria-label="Chilton App Works homepage">
        <img src={logoUrl} width="320" height="125" alt="Chilton App Works, official blue and green logo" loading="eager" />
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#why">Why a website?</a>
        <a href="#services">Services</a>
        <a href="#pricing">Pricing</a>
        <a href="#care">Monthly care</a>
      </nav>
      <a class="button header-button" href={mail('New website or custom app project')}>Let's talk <span aria-hidden="true">↗</span></a>
      <details class="mobile-nav">
        <summary aria-label="Open navigation">Menu <span aria-hidden="true">☰</span></summary>
        <nav aria-label="Mobile navigation"><a href="#why">Why a website?</a><a href="#services">Services</a><a href="#pricing">Pricing</a><a href="#care">Monthly care</a><a href="#contact">Contact</a></nav>
      </details>
    </div>
  </header>

  <main id="main">
    <section id="home" class="hero">
      <div class="page-width hero-grid">
        <div class="hero-copy">
          <span class="eyebrow"><span class="mini-star">✳</span> BUILT IN WISCONSIN. BUILT FOR SMALL BUSINESS.</span>
          <h1>Look like a<br/><em>million bucks.</em><br/>Start at <span class="price-text">$149.</span></h1>
          <p>Professional websites and practical custom software, without giant agency prices or confusing contracts. Your business deserves a better digital first impression.</p>
          <div class="hero-buttons">
            <a class="button button-green" href="#pricing">See website packages <span aria-hidden="true">↗</span></a>
            <a class="button-text" href="#services">Explore what we do <span aria-hidden="true">↗</span></a>
          </div>
          <p class="hero-disclosure">One-page starter design from $149 one-time. Domain, hosting, email and optional extras are additional.</p>
        </div>
        <div class="hero-graphic" aria-label="Illustration of a small business website concept">
          <div class="grid-lines" aria-hidden="true"></div>
          <div class="hero-window">
            <div class="window-top"><span class="window-dots">● ● ●</span><span>yourbusiness.com</span><span>↗</span></div>
            <div class="window-content">
              <div class="window-nav"><b>YOUR BUSINESS <span>✳</span></b><small>ABOUT&nbsp; SERVICES&nbsp; CONTACT</small></div>
              <span class="window-caption">YOUR NEIGHBORHOOD. YOUR STORY.</span>
              <h2>Make a<br/><em>great first<br/>impression.</em></h2>
              <span class="window-action">GET IN TOUCH &nbsp; ↗</span>
              <div class="window-panels"><i></i><i></i><i></i></div>
            </div>
          </div>
          <div class="hero-sticker"><span>SMALL<br/>BUSINESS<br/>BIG IDEAS</span><b>✳</b></div>
          <div class="graphic-foot">DESIGN THAT WORKS · NO HIDDEN SURPRISES</div>
        </div>
      </div>
    </section>

    <section class="trust-strip"><div class="page-width"><span>✓ Transparent pricing</span><span>✓ You own your domain</span><span>✓ Optional maintenance</span><span>✓ No unnecessary contracts</span></div></section>

    <section id="why" class="section page-width">
      <div class="section-header"><div><span class="eyebrow blue">WHY YOUR ONLINE PRESENCE MATTERS</span><h2>Your next customer<br/>is already <em>looking.</em></h2></div><p>A website isn't just an online business card. It's a place for customers to confirm you're real, understand what you offer and contact you quickly.</p></div>
      <div class="statistics">
        <article><strong>84%</strong><p>of surveyed U.S. consumers searched for a local business online in the previous three months.</p><a href="https://www.brightlocal.com/research/consumer-search-behavior-channels/" target="_blank" rel="noopener noreferrer">BrightLocal · 2026 research ↗</a></article>
        <article><strong>73%</strong><p>of recent local-business searches in the study began on a mobile device.</p><a href="https://www.brightlocal.com/research/consumer-search-behavior-channels/" target="_blank" rel="noopener noreferrer">BrightLocal · 2026 research ↗</a></article>
        <article><strong>20%</strong><p>ranked a professional-looking website among their top three reasons to contact or visit a business.</p><a href="https://www.brightlocal.com/research/consumer-search-behavior-decisions/" target="_blank" rel="noopener noreferrer">BrightLocal · 2026 research ↗</a></article>
      </div>
      <p class="research-note">These figures describe consumer survey responses, not a promised increase in revenue from any particular website. The decision research surveyed 1,227 recent U.S. local searchers.</p>
    </section>

    <section id="services" class="services-section">
      <div class="page-width section">
        <div class="section-header light"><div><span class="eyebrow">WHAT WE CAN BUILD</span><h2>Useful technology.<br/><em>Within reach.</em></h2></div><p>We create polished websites and practical tools for real businesses. From a simple introduction online to a custom application, you only pay for the work your project actually needs.</p></div>
        <div class="service-grid">
          <article><div class="service-icon">▣</div><h3>Professional websites</h3><p>Mobile-friendly design, clear services, helpful contact information and a stronger first impression.</p><a href="#pricing">View website prices ↗</a></article>
          <article><div class="service-icon">⌘</div><h3>Custom applications</h3><p>Internal dashboards, scheduling tools, customer portals, workflow systems and custom solutions.</p><a href={mail('Custom application development')}>Request a custom quote ↗</a></article>
          <article><div class="service-icon">☁</div><h3>Hosting & maintenance</h3><p>Optional hosting coordination, SSL, monitoring and a defined amount of help with content changes.</p><a href="#care">Explore monthly plans ↗</a></article>
          <article><div class="service-icon">@</div><h3>Business email</h3><p>Professional addresses at your domain, with your choice of mailbox provider and transparent setup costs.</p><a href={mail('Business email setup')}>Ask about email setup ↗</a></article>
        </div>
        <div class="custom-note"><div><span>HAVE A BIGGER IDEA?</span><h3>Custom apps, made for your work.</h3><p>We quote software individually. Features, security, testing, integrations, infrastructure and ongoing support are scoped and disclosed before development.</p></div><a href={mail('Custom software project')}>Talk to us about an app ↗</a></div>
      </div>
    </section>

    <section id="pricing" class="section page-width">
      <div class="section-header"><div><span class="eyebrow blue">FAIR, SIMPLE PRICING</span><h2>Get online for<br/><em>less than you think.</em></h2></div><p>These are starting prices for clearly defined websites. No inflated bundles, no surprise additions. Every project gets an agreed scope before we begin.</p></div>
      <div class="package-grid">
        {packages.map((plan, idx)=> <article class:list={['package', {'preferred':idx===0}]}>
          <div class="package-top">{idx===0 ? <span class="package-pill">START HERE</span> : <span class="package-pill subtle">WEBSITE PACKAGE</span>}<h3>{plan.name}</h3><p>{plan.blurb}</p></div>
          <div class="package-cost"><strong>{plan.price}</strong><span>one-time build</span></div>
          <ul>{plan.features.map(f=><li><span class="tick" aria-hidden="true">✓</span>{f}</li>)}</ul>
          <p class="package-note">{plan.note}</p>
          <a class="package-button" href={mail(plan.subject)}>Ask about this package <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
      <p class="extra-page"><b>Need more pages?</b> Additional pages start at <strong>$99 each</strong>. Advanced forms, e-commerce, bookings, custom content and integrations are separately quoted.</p>
      <div class="transparent-note"><span class="big-check">✓</span><p><b>What you see is what you get.</b> Domain registration and renewals, hosting, paid email subscriptions, third-party services and unusual usage costs are separate. We explain and get approval for extras up front. Customers own their domains and the final agreed deliverables.</p></div>
    </section>

    <section id="care" class="care-section">
      <div class="page-width section">
        <div class="section-header"><div><span class="eyebrow blue">OPTIONAL WEBSITE CARE</span><h2>We can handle<br/><em>the upkeep, too.</em></h2></div><p>Want someone to watch over your website? Choose a small monthly plan. Prefer to host it elsewhere? That's fine, too.</p></div>
        <div class="care-grid">
          {maintenance.map(plan=> <article><div class="care-head"><h3>{plan.name}</h3><div><strong>{plan.price}</strong><span>/month</span></div></div><ul>{plan.items.map(item=><li>✓ &nbsp; {item}</li>)}</ul></article>)}
        </div>
        <p class="care-footnote">Optional month-to-month website care, cancellable with 30 days notice. Standard plans assume a suitable static site and reasonable usage. Domains, mailbox licenses, paid integrations, substantial updates and unexpected provider charges are separately discussed and approved. Unused edit minutes do not roll over.</p>
        <div class="email-callout"><div><span class="eyebrow blue">PROFESSIONAL EMAIL</span><h3>Your name. Your business. Your inbox.</h3><p>First mailbox setup starts at <b>$49 one-time</b>, plus any domain and ongoing email-provider license costs. Your business owns the email account.</p></div><a class="button button-dark" href={mail('Professional business email')}>Ask about email <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="section page-width how-it-works">
      <div class="section-header"><div><span class="eyebrow blue">SIMPLE FROM START TO FINISH</span><h2>A better website.<br/><em>Without the headache.</em></h2></div><p>Clear communication and defined deliverables make a small budget go further.</p></div>
      <div class="steps"><article><span class="step-icon">✉</span><h3>Tell us about your business.</h3><p>We discuss your goals and the information customers need to find.</p></article><article><span class="step-icon">▤</span><h3>Get a straightforward quote.</h3><p>We'll agree on the pages, revisions, schedule and separate provider costs.</p></article><article><span class="step-icon">◈</span><h3>Review the design.</h3><p>We create and test your website, then make the agreed adjustments.</p></article><article><span class="step-icon">✓</span><h3>Go live on your domain.</h3><p>You own your site and choose whether you want ongoing care.</p></article></div>
    </section>

    <section class="faq-section section" id="faq"><div class="page-width faq-grid"><div><span class="eyebrow blue">QUESTIONS, ANSWERED</span><h2>No confusing<br/><em>fine print.</em></h2><p>Affordable should never mean mysterious.</p></div><div class="questions">{faq.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>

    <section id="contact" class="contact-section"><div class="page-width contact-grid"><div><span class="eyebrow">A BETTER ONLINE PRESENCE STARTS HERE</span><h2>Let's make<br/><em>your idea</em><br/>happen.</h2><p>Tell us what you do and what you need. We'll help find the right-sized solution, whether that's a $149 starter or a custom business application.</p><div class="contact-location">✳ &nbsp; Based in Chilton, Wisconsin</div></div><div class="contact-card"><span>READY TO TALK?</span><h3>Start with a quick email.</h3><p>Share your business name, the website package you're interested in and a little about your goals. We'll reply with the next steps.</p><a class="button button-green" href={mail('New website inquiry - starting at $149')}>Email Chilton App Works <span aria-hidden="true">↗</span></a><a class="plain-email" href="mailto:Geoffrey@86chaos.com">Geoffrey@86chaos.com</a><small>Temporary preview: inquiry links open your email application. No form data is collected by this page.</small></div></div></section>
  </main>

  <footer><div class="page-width footer-inner"><div><div class="footer-name">Chilton App Works <span>✳</span></div><p>Websites, custom apps and straightforward digital help for small businesses.</p></div><div class="footer-links"><a href="#pricing">Website pricing</a><a href="#care">Monthly care</a><a href="#services">Custom apps</a><a href="https://www.86chaos.com/">86 Chaos</a></div><small>© 2026 Chilton App Works LLC · Temporary preview hosted on 86chaos.com</small></div></footer>
</body>
</html>

<style>
