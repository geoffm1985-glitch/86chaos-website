const offers = [
  {name:'One-Page Starter',price:'$149',intro:'Launch a clean, credible online presence.',perks:['One professional, mobile-friendly page','Tested design template','Your provided logo, photos and copy','Contact links and basic search setup','One revision round'],detail:'Domain, hosting, email and add-ons separate.',slug:'One-Page Starter $149'},
  {name:'Small Business',price:'$349',intro:'Make room for the details customers need.',perks:['Up to three responsive pages','Business colors and branding','About, services and contact pages','Basic local-search setup','One revision round'],detail:'Advanced forms and extra work quoted first.',slug:'Small Business website $349'},
  {name:'Business Plus',price:'$599',intro:'A little more custom. A lot more presence.',perks:['Up to five responsive pages','More customized page layouts','Gallery or service showcase','Clear calls to action','Two revision rounds'],detail:'Complex features and external services separately quoted.',slug:'Business Plus website $599'}
];
const care = [
{name:'Basic Hosting',price:'$19',detail:'Managed static hosting, SSL and monitoring. Edits quoted separately.'},
{name:'Managed Care',price:'$39',detail:'Basic Hosting benefits plus up to 15 minutes of minor edits each month.'},
{name:'Premium Care',price:'$69',detail:'Basic Hosting benefits plus up to 30 minutes of minor edits each month.'}
