<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#080d12" />
    <meta name="description" content="86 Chaos. The ultimate restaurant command center is coming." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="86 Chaos | The Ultimate Restaurant Command Center Is Coming" />
    <meta property="og:description" content="The ultimate restaurant command center is coming." />
    <meta property="og:image" content="https://www.86chaos.com/assets/logo-main.png" />
    <meta property="og:url" content="https://www.86chaos.com/" />
    <link rel="canonical" href="https://www.86chaos.com/" />
    <link rel="icon" type="image/webp" href="/assets/app-icon.webp" />
    <link rel="apple-touch-icon" href="/assets/app-icon.webp" />
    <title>86 Chaos | The Ultimate Restaurant Command Center Is Coming</title>
    <style is:global>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      * { box-sizing: border-box; }
      html { min-height: 100%; background: #05080c; }
      body { margin: 0; color: #f6f1ec; min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; position: relative; isolation: isolate; overflow-x: hidden; }
      body::before { content: ""; position: fixed; inset: 0; background: url("/assets/site-background-clean-v59.png") center center / cover no-repeat; opacity: .70; z-index: -2; pointer-events: none; }
      body::after { content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(180deg, rgba(5,8,12,.38) 0%, rgba(5,8,12,.51) 48%, rgba(5,8,12,.64) 100%), radial-gradient(circle at 50% 46%, rgba(201,143,109,.12), transparent 48%); }
      main { flex: 1; width: 100%; min-height: 520px; display: flex; align-items: center; justify-content: center; padding: clamp(40px, 7vh, 84px) 22px 30px; }
      .announcement { width: min(100%, 1050px); text-align: center; display: flex; flex-direction: column; align-items: center; }
      .logo { width: clamp(260px, 47vw, 535px); max-width: 88%; height: auto; display: block; margin: 0 auto clamp(58px, 9vh, 98px); }
      .eyebrow { margin: 0 0 24px; color: #e7ba91; font-weight: 760; letter-spacing: .38em; font-size: clamp(.69rem, 1.45vw, .83rem); text-transform: uppercase; }
      h1 { font-weight: 850; font-size: clamp(2.75rem, 6.6vw, 6.35rem); line-height: .99; letter-spacing: -.067em; margin: 0; text-wrap: balance; text-shadow: 0 8px 44px rgba(0,0,0,.46); }
      h1 span { display: block; }
      h1 .accent { padding-block: .07em; background: linear-gradient(105deg, #f6dcc3 0%, #e8b187 45%, #b96f45 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .rule { width: 74px; height: 2px; background: linear-gradient(90deg, transparent, #dfaa83, transparent); margin: clamp(32px, 6vh, 55px) auto 0; }
      .sub { color: #dfd8d2; letter-spacing: .035em; font-weight: 430; font-size: clamp(.9rem, 1.7vw, 1.15rem); line-height: 1.55; margin: 20px 0 0; max-width: 540px; text-shadow: 0 2px 16px #000b; }
      footer { padding: 0 16px max(22px, env(safe-area-inset-bottom)); text-align: center; color: rgba(235,230,225,.6); font-size: .75rem; letter-spacing: .04em; }
      @media (max-width: 650px) {
        main { min-height: 560px; padding-inline: 20px; }
        .logo { width: min(84vw, 420px); margin-bottom: clamp(54px, 10vh, 90px); }
        .eyebrow { letter-spacing: .3em; }
        h1 { font-size: clamp(2.55rem, 10vw, 4.7rem); letter-spacing: -.055em; line-height: 1.025; }
        .sub { max-width: 310px; }
      }
      @media (prefers-reduced-motion: no-preference) { .announcement { animation: appear .7s ease-out both; } @keyframes appear { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } } }
    </style>
  </head>
  <body>
    <main>
      <section class="announcement" aria-labelledby="announcement-title">
        <img class="logo" src="/assets/logo-main.png" width="640" height="360" alt="86 Chaos Kitchen Management OS" />
        <p class="eyebrow">Coming soon</p>
        <h1 id="announcement-title">
          <span>The ultimate</span>
          <span class="accent">restaurant command center</span>
          <span>is coming.</span>
        </h1>
        <div class="rule" aria-hidden="true"></div>
        <p class="sub">One restaurant. One command center. Less chaos.</p>
      </section>
    </main>
    <footer>© 2026 Chilton App Works LLC</footer>
  </body>
</html>
