---
import TeaserLayout from '../layouts/TeaserLayout.astro';
import { CONSENT_TEXT } from '../lib/launch-signup.mjs';
const features = [
  {num:'01', title:'A clearer start to every shift.', tag:'RESTAURANT COMMAND CENTER', text:'A manager’s brief, daily priorities and operational alerts. One place to see what needs attention before the rush begins.', items:['Daily briefings','Actionable alerts','Connected operations'], icon:'command'},
  {num:'02', title:'The right people. A better plan.', tag:'SCHEDULING & TIME', text:'Bring schedules, availability, time-off requests and shift changes together. Connect the plan with time clocks, timesheets and labor visibility.', items:['Schedule building','Availability & time off','Time clock & timesheets'], icon:'schedule'},
  {num:'03', title:'Know what’s on the shelf.\nAnd what it’s costing you.', tag:'INVENTORY & FOOD COST', text:'Connect counts, invoices, ingredient costs and purchasing. Track waste, review scanning results and plan orders around the stock you actually have.', items:['Invoice scanning & review','Par levels & ordering','Waste & cost tracking'], icon:'inventory'},
  {num:'04', title:'Make every plate count.', tag:'RECIPES & MENU INSIGHT', text:'Keep recipes, portions and ingredient costs connected. Understand menu profitability and give your kitchen clear instructions for consistent execution.', items:['Recipe costing','Batch scaling','Menu profitability'], icon:'recipe'},
  {num:'05', title:'A team that knows what’s next.', tag:'PREP & DAILY OPERATIONS', text:'Give prep, opening routines and closing checklists a clear owner. Keep labels, maintenance and daily responsibilities part of the same working day.', items:['Prep & task assignments','Opening & closing','Labels & maintenance'], icon:'check'},
  {num:'06', title:'See beyond a busy dining room.', tag:'FINANCIAL & LABOR INSIGHT', text:'Bring daily closing, labor costs and financial reports into view. Exports connect approved records with your accountant and chosen payroll provider.', items:['Guided Daily Close','Labor & financial reports','Accounting exports'], icon:'chart'}
];
---
<TeaserLayout>
  <main id="main">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="eyebrow launch-status"><span class="status-dot" aria-hidden="true"></span> Coming soon · Built for independents</div>
      <h1 id="hero-title">Big restaurant<br />technology.<br /><span class="copper-text">Small business pricing.</span></h1>
      <p class="hero-subtitle">The Ultimate Restaurant Command Center Is Coming.</p>
      <p class="hero-description">Your people. Your kitchen. Your business.<br class="desktop-break" /> The tools you need, coming together in one powerful, easy-to-use platform.</p>
      <div class="hero-actions"><a class="button button-primary" href="#launch">Get Launch Updates <span aria-hidden="true">↗</span></a><a class="text-link" href="#vision">Explore What’s Coming <span aria-hidden="true">↓</span></a></div>
      <p class="hero-footnote">For independent restaurants, bars and the people who run them.</p>
      <div class="brand-stage" aria-label="86 Chaos Kitchen Management OS">
        <picture><source srcset="/assets/brand-scene.webp" type="image/webp" /><img src="/assets/site-background-clean-v59.png" alt="86 Chaos Kitchen Management OS — copper and steel branding with a restaurant kitchen and Wisconsin backdrop" width="1671" height="941" fetchpriority="high" /></picture>
        <div class="stage-bottom"><span>BUILT FOR THE WORK. BUILT FOR YOU.</span><span aria-hidden="true">86 / LESS CHAOS</span></div>
      </div>
    </section>
    <div class="principle-strip"><div class="section-shell"><span>Independent by design</span><span>No hidden charges</span><span>No long-term contracts</span></div></div>
    <section id="vision" class="section-shell section-space" aria-labelledby="vision-title">
      <div class="section-intro"><div><p class="eyebrow">One restaurant. One command center.</p><h2 id="vision-title">Less piecing it together.<br /><span class="muted">More running your restaurant.</span></h2></div><p>Schedules in one place. Inventory in another. The rest in your head. 86 Chaos brings it together—from the first prep list to the final close.</p></div>
      <div class="feature-grid">
        {features.map((feature, index) => <article class:list={['feature', {'feature-wide':index === 0 || index === 2}]}>
          <div class="feature-top"><span class="eyebrow">{feature.tag}</span><span class="feature-num" aria-hidden="true">{feature.num}</span></div>
          <h3>{feature.title}</h3><p>{feature.text}</p>
          {index === 0 && <div class="workflow-art" aria-label="Illustration of a connected restaurant workflow"><div class="workflow-center"><span class="status-dot" aria-hidden="true"></span> YOUR RESTAURANT</div><div class="workflow-points"><span>People</span><span>Kitchen</span><span>Business</span></div><div class="workflow-line" aria-hidden="true"></div><div class="workflow-outcome">A clearer picture of the day <span aria-hidden="true">↗</span></div><small>Illustration</small></div>}
          {index === 2 && <div class="inventory-art" aria-label="Workflow: receive, count, cost, plan"><span>Receive</span><i aria-hidden="true">→</i><span>Count</span><i aria-hidden="true">→</i><span>Cost</span><i aria-hidden="true">→</i><span>Plan</span></div>}
          <ul class="feature-items">{feature.items.map(item => <li>{item}</li>)}</ul>
        </article>)}
      </div>
    </section>
    <section class="team-section section-shell" aria-labelledby="team-title">
      <div class="team-copy"><p class="eyebrow">People make the place</p><h2 id="team-title">Give your team<br />more than a login.</h2><p>Onboarding, restaurant manuals, short lessons and practical skill sign-offs help employees learn the way your restaurant works. Training records and credential-renewal reminders keep everyone current.</p><p>Connect the team with messages, announcements, shift communication and 86 alerts—so important information has a place to go.</p></div>
      <div class="team-art"><div class="training-heading"><span class="eyebrow">From first day to a stronger team</span><span aria-hidden="true">↗</span></div><ol><li><span>01</span><div><strong>Welcome</strong><p>Onboarding & restaurant resources</p></div></li><li><span>02</span><div><strong>Learn</strong><p>Manuals, lessons & knowledge checks</p></div></li><li><span>03</span><div><strong>Put it into practice</strong><p>Manager-verified skills & training records</p></div></li><li><span>04</span><div><strong>Stay connected</strong><p>Team updates & shift communication</p></div></li></ol><p class="art-caption">Illustration</p></div>
    </section>
    <section class="intelligence section-shell section-space" aria-labelledby="intelligence-title">
      <div class="intelligence-symbol" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <p class="eyebrow">86Voice & restaurant intelligence</p><h2 id="intelligence-title">A little more insight.<br /><span class="copper-text">A lot less guesswork.</span></h2><p>Voice and typed assistance, connected to the work of running a restaurant. Ask for information, understand an alert, or review a suggested next step—with meaningful changes kept under your control.</p><div class="intelligence-details"><span>Information grounded in your records</span><span>Recommendations you can understand</span><span>You review. You decide.</span></div>
    </section>
    <section id="principles" class="honest-section" aria-labelledby="honest-title"><div class="section-shell section-space">
      <p class="eyebrow">Our commitment to independent operators</p><h2 id="honest-title">Powerful software.<br />Honest pricing.<br /><span class="copper-text">No surprises.</span></h2>
      <p class="honest-intro">You have enough unpredictable costs. Your software shouldn’t be another one.</p>
      <div class="promises"><article><span aria-hidden="true">01 /</span><h3>Know what’s included.</h3><p>No hidden charges. Clear subscription terms, included features and applicable usage limits before you subscribe.</p></article><article><span aria-hidden="true">02 /</span><h3>Keep your freedom.</h3><p>No long-term contracts. Affordable by design, with straightforward information to help you choose what fits your restaurant.</p></article><article><span aria-hidden="true">03 /</span><h3>Choose extras knowingly.</h3><p>Optional services, third-party charges and AI or scanning allowances disclosed clearly. No misleading pricing tricks.</p></article></div>
      <div class="service-note"><strong>A clear line between software and hands-on help.</strong><p>Guided self-service setup and resources help you get started. Hands-on onboarding, setup, data migration, custom configuration and personalized training by Chilton App Works personnel are optional professional services and may carry separately quoted charges, approved by you in advance. Applicable integration, payment-processing and other third-party costs will be disclosed separately.</p></div>
      <p class="pricing-note">Subscription details will be announced closer to launch.</p>
    </div></section>
    <section class="section-shell compatibility section-space" aria-labelledby="compatibility-title"><div><p class="eyebrow">Your restaurant. Your choices.</p><h2 id="compatibility-title">Build on what<br />works for you.</h2></div><div><p>86 Chaos is built to work alongside your existing POS and payment setup where technically supported. Supported connections are confirmed before you rely on them.</p><p>Payroll-ready records and exports for your accountant. Specific POS, accounting and payroll connections are listed once verified; not every system is supported.</p></div></section>
    <section id="story" class="founder section-shell" aria-labelledby="story-title"><div class="founder-number"><span>25</span><p>YEARS, APPROXIMATELY.<br />ONE VERY REAL PERSPECTIVE.</p></div><div><p class="eyebrow">The experience behind 86 Chaos</p><h2 id="story-title">Built in the kitchen.<br /><span class="muted">Not in a boardroom.</span></h2><p>86 Chaos was conceived by a restaurant professional with approximately 25 years of kitchen experience. The pressure of service. Tight budgets. Scheduling headaches. Inventory, food costs and keeping a team on the same page.</p><p>That firsthand perspective is shaping a platform built with respect for the people doing the work—and the independent businesses they keep running.</p><div class="company-signature"><span class="signature-rule" aria-hidden="true"></span><span>86 CHAOS <small>BY CHILTON APP WORKS LLC</small></span></div></div></section>
    <section id="launch" class="signup-section section-shell section-space" aria-labelledby="launch-title"><div class="signup-copy"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> The next chapter is coming</p><h2 id="launch-title">Your restaurant has<br />enough chaos.<br /><span class="copper-text">Be here for what’s next.</span></h2><p>Get product news and launch updates. Be among the first to learn what’s coming together.</p><p class="signup-assurance">No purchase. No commitment. Just updates you choose to receive.</p><a class="contact-link" href="mailto:Geoffrey@86chaos.com">Geoffrey@86chaos.com <span aria-hidden="true">↗</span></a></div>
      <div class="signup-card"><h3>Get Launch Updates</h3><p class="form-intro">A better way to run your restaurant is on the way.</p>
        <form id="launch-form" action="/api/launch-signup" method="post" aria-describedby="form-status">
          <fieldset id="signup-fields" disabled><legend class="sr-only">Launch update signup</legend>
            <div class="field"><label for="email">Email address <span>(required)</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@yourrestaurant.com" required /></div>
            <div class="field"><label for="first-name">First name <span>(optional)</span></label><input id="first-name" name="name" autocomplete="given-name" maxlength="80" /></div>
            <div class="field"><label for="restaurant">Restaurant or business name <span>(optional)</span></label><input id="restaurant" name="restaurant" autocomplete="organization" maxlength="160" /></div>
            <div class="honeypot" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
            <label class="consent" for="consent"><input id="consent" name="consent" type="checkbox" required /><span>{CONSENT_TEXT}</span></label>
            <div id="turnstile-widget"></div><button id="signup-submit" class="button button-primary" type="submit">Get Launch Updates <span aria-hidden="true">↗</span></button>
          </fieldset>
          <p id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1">Checking signup availability…</p><noscript><p>JavaScript is needed for secure signup. You can contact <a href="mailto:Geoffrey@86chaos.com">Geoffrey@86chaos.com</a>.</p></noscript>
          <p class="privacy-note">We use your details for 86 Chaos product and launch updates. Request removal anytime by email. <a href="/privacy">Read our privacy notice.</a></p>
        </form>
      </div>
    </section>
  </main>
  <script src="../scripts/teaser.ts"></script>
</TeaserLayout>
