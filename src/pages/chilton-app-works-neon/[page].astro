---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#040e13"/>
<meta name="description" content={"Chilton App Works — "+titleLookup[page]+". Original neon design with useful website, software and support information."}/>
<title>{titleLookup[page]} | Chilton App Works</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#040e13;color:#d9eeee;font-family:Arial,Helvetica,sans-serif}
img{display:block;width:100%;height:auto;user-select:none;pointer-events:none}
a,button,summary{-webkit-tap-highlight-color:transparent;touch-action:manipulation}
.page-frame{width:min(1122px,100%);margin:0 auto;background:#050f14;box-shadow:0 0 90px #17ccb61b}
.poster-scroll{width:100%;overflow-x:auto;overscroll-behavior-inline:contain}
.poster{position:relative;width:100%;min-width:0;aspect-ratio:1122 / 1334;background:#050e14}
.poster img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
.hotspot{position:absolute;z-index:3;display:block;background:transparent;border:0;outline:none;box-shadow:none;cursor:pointer}
.hotspot:focus-visible{outline:2px solid #37f3e3;outline-offset:2px}
.hotspot:focus:not(:focus-visible),.hotspot:active{outline:none;box-shadow:none;background:transparent}
.hotspot span{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.aux{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:13px 18px;background:#071820;border-top:1px solid #17656b;color:#93c6c9;font-size:11px;line-height:1.55}
.aux a{color:#43e8db;text-decoration:underline;text-underline-offset:3px}
.zoom-controls{display:none;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;background:#092029;border-bottom:1px solid #1f6064;font-size:11px}
.zoom-controls button{padding:8px 11px;border-radius:7px;background:#0b2a2f;border:1px solid #43dfd6;color:#bffdfa;font-size:11px;font-weight:800}
.poster-scroll.zoomed .poster{width:1122px}
@media(max-width:700px){.zoom-controls{display:flex}.aux{display:block}.aux a{display:block;margin-top:7px}}
</style></head><body>
<div class="page-frame">
  <div class="zoom-controls"><span>Image-based {titleLookup[page]} page · zoom to read details</span><button id="zoom" aria-pressed="false" type="button">Zoom in ⤢</button></div>
  <main class="poster-scroll" id="poster-scroll">
    <div class="poster">
      <img src={`/assets/chilton-neon/${page}.svg`} alt={`Chilton App Works neon illustrated ${titleLookup[page]} page. Use the labeled links to browse sections.`} loading="eager" width="1122" height="1334"/>
      {contacts.map(p=><a class="hotspot" aria-label={p.label} href={p.href} style={`left:${percent(p.x,1122)};top:${percent(p.y,1334)};width:${percent(p.w,1122)};height:${percent(p.h,1334)}`}><span>{p.label}</span></a>)}
    </div>
  </main>
  <div class="aux"><span>Neon design preview · Prices are starting prices; domain, hosting, email licenses and optional work are separate.</span><a href={route}>Return to landing page ↗</a></div>
</div>
<script>
 const scroller=document.querySelector('#poster-scroll');const button=document.querySelector('#zoom');
 if(scroller&&button)button.addEventListener('click',()=>{
   const expanded=scroller.classList.toggle('zoomed');
   button.textContent=expanded?'Fit screen ↙':'Zoom in ⤢';
   button.setAttribute('aria-pressed',String(expanded));scroller.scrollLeft=0;
 });
</script>
</body></html>