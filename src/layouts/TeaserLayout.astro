---
import '../styles/teaser.css';
const { title = '86 Chaos | Big Restaurant Technology. Small Business Pricing.', description = 'The Ultimate Restaurant Command Center Is Coming. Planned all-in-one restaurant management, built for independent restaurants and bars by Chilton App Works LLC.', path = '/' } = Astro.props;
const canonical = `https://www.86chaos.com${path}`;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><meta name="theme-color" content="#090c10" /><link rel="canonical" href={canonical} /><link rel="icon" type="image/webp" href="/assets/app-icon.webp" /><link rel="apple-touch-icon" href="/assets/app-icon.webp" /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://www.86chaos.com/assets/brand-scene.webp" /><meta property="og:image:width" content="1671" /><meta property="og:image:height" content="941" /><meta property="og:image:alt" content="86 Chaos — Kitchen Management OS. Coming soon." /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content="https://www.86chaos.com/assets/brand-scene.webp" /></head>
<body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="nav-inner"><a class="brand-link" href="/" aria-label="86 Chaos home"><img src="/assets/logo-main.png" alt="86 Chaos" width="1536" height="864" /></a><nav aria-label="Main navigation"><a href="/#vision">The vision</a><a href="/#principles">Our principles</a><a href="/#story">Our story</a></nav><a class="nav-cta" href="/#launch">Get Launch Updates <span aria-hidden="true">↗</span></a></div></header><slot /><footer class="site-footer section-shell"><a class="footer-brand" href="/">86 CHAOS<span>Less chaos. More possibility.</span></a><div><a href="mailto:Geoffrey@86chaos.com">Contact</a><a href="/privacy">Privacy</a><span>© {new Date().getFullYear()} Chilton App Works LLC</span></div></footer></body></html>
